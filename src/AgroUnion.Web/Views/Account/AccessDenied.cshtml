@{ ViewData["Title"] = "Δεν επιτρέπεται η πρόσβαση"; }

<section class="section">
    <div class="container-narrow" style="text-align:center">
        <div style="display:inline-grid;place-items:center;width:72px;height:72px;background:var(--danger-bg);color:var(--danger);border-radius:16px;font-size:26px;margin-bottom:24px">
            <i class="fa-solid fa-user-lock"></i>
        </div>
        <div class="overline plain" style="justify-content:center;color:var(--danger)">403 · Πρόσβαση</div>
        <h1 style="margin-top:12px">Αυτό το τμήμα δεν ανήκει στον ρόλο σας.</h1>
        <p class="lead text-muted" style="max-width:560px;margin:20px auto 32px">Τα δεδομένα του portal διαχωρίζονται αυστηρά ανά συνεργάτη και ρόλο. Επιστρέψτε στην επισκόπησή σας ή επικοινωνήστε με τον διαχειριστή.</p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
            <a class="btn" asp-controller="Portal" asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Επιστροφή στο portal</a>
            <a class="btn btn-secondary" asp-controller="Home" asp-action="Contact">Επικοινωνία με διαχείριση</a>
        </div>
    </div>
</section>
