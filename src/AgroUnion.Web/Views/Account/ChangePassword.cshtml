@model AgroUnion.Web.ViewModels.ChangePasswordForm
@{ ViewData["Title"] = "Αλλαγή κωδικού"; }

<div class="auth-page" style="--auth-img:url(/images/photography/hero-fields.jpg)">
    <aside class="auth-visual">
        <div>
            <div class="overline">Ασφάλεια λογαριασμού</div>
            <h1>Προστατεύουμε κάθε συνεργασία.</h1>
            <p>Χρησιμοποιήστε έναν μοναδικό κωδικό με τουλάχιστον 10 χαρακτήρες, κεφαλαίο, πεζό, αριθμό και σύμβολο. Μην τον ξαναχρησιμοποιήσετε σε άλλες υπηρεσίες.</p>
        </div>
        <div class="auth-visual-footer">AGRO UNION · Πύλη συνεργατών</div>
    </aside>
    <section class="auth-panel">
        <form class="auth-form" method="post">
            <div>
                <h2>Αλλαγή κωδικού</h2>
                <p>Μετά την αλλαγή θα παραμείνετε συνδεδεμένοι.</p>
            </div>
            <div asp-validation-summary="All" class="validation-summary"></div>
            <div class="field">
                <label class="field-label">Τρέχων κωδικός</label>
                <input asp-for="CurrentPassword" class="form-input" type="password" autocomplete="current-password" />
            </div>
            <div class="field">
                <label class="field-label">Νέος κωδικός</label>
                <input asp-for="NewPassword" class="form-input" type="password" autocomplete="new-password" />
            </div>
            <div class="field">
                <label class="field-label">Επιβεβαίωση νέου κωδικού</label>
                <input asp-for="ConfirmPassword" class="form-input" type="password" autocomplete="new-password" />
            </div>
            <button class="btn btn-lg" type="submit">Αποθήκευση νέου κωδικού <i class="fa-solid fa-arrow-right"></i></button>
            <div class="form-row" style="justify-content:center">
                <a asp-controller="Portal" asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Επιστροφή στο portal</a>
            </div>
        </form>
    </section>
</div>
