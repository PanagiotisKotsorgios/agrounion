@model AgroUnion.Web.ViewModels.ForgotPasswordForm
@{ ViewData["Title"] = "Επαναφορά κωδικού"; Layout = "_AuthLayout"; }

<div class="auth-page" style="--auth-img:url(/images/photography/hero-vineyard.jpg)">
    <aside class="auth-visual">
        <div>
            <div class="overline">Ανάκτηση κωδικού</div>
            <h1>Ας σας στείλουμε νέο σύνδεσμο.</h1>
            <p>Θα λάβετε στο email σας έναν ασφαλή σύνδεσμο για να ορίσετε νέο κωδικό πρόσβασης. Ισχύει για περιορισμένο χρονικό διάστημα.</p>
            <ul class="visual-list">
                <li><i class="fa-solid fa-shield-halved"></i><span>Κρυπτογραφημένος σύνδεσμος με λήξη</span></li>
                <li><i class="fa-solid fa-envelope"></i><span>Άμεση αποστολή στη διεύθυνση του λογαριασμού</span></li>
            </ul>
        </div>
        <div class="auth-visual-footer">AGRO UNION · Πύλη συνεργατών</div>
    </aside>
    <section class="auth-panel">
        <form class="auth-form" asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
            <div>
                <h2>Ξεχάσατε τον κωδικό;</h2>
                <p>Γράψτε το email του λογαριασμού σας και θα σας στείλουμε ασφαλή σύνδεσμο επαναφοράς.</p>
            </div>
            @if (TempData["PasswordResetRequested"] is string message)
            {
                <div class="alert info"><i class="fa-solid fa-circle-check"></i><span>@message</span></div>
            }
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="field">
                <label asp-for="Email" class="field-label">Email λογαριασμού</label>
                <input asp-for="Email" class="form-input" type="email" autocomplete="email" placeholder="name@example.gr" autofocus />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="honeypot" aria-hidden="true"><input asp-for="Website" tabindex="-1" autocomplete="off" /></div>
            <button class="btn btn-lg" type="submit">Αποστολή συνδέσμου <i class="fa-solid fa-arrow-right"></i></button>
            <div class="form-row" style="justify-content:center">
                <a asp-controller="Account" asp-action="Login"><i class="fa-solid fa-arrow-left"></i> Επιστροφή στην είσοδο</a>
            </div>
        </form>
    </section>
</div>
