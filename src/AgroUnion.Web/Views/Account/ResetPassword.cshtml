@model AgroUnion.Web.ViewModels.ResetPasswordForm
@{ ViewData["Title"] = "Νέος κωδικός"; Layout = "_AuthLayout"; }

<div class="auth-page" style="--auth-img:url(/images/photography/hero-vineyard.jpg)">
    <aside class="auth-visual">
        <div>
            <div class="overline">Νέος κωδικός</div>
            <h1>Επιλέξτε έναν ισχυρό κωδικό.</h1>
            <p>Χρησιμοποιήστε τουλάχιστον 10 χαρακτήρες, έναν κεφαλαίο, έναν πεζό, έναν αριθμό και ένα σύμβολο.</p>
        </div>
        <div class="auth-visual-footer">AGRO UNION · Πύλη συνεργατών</div>
    </aside>
    <section class="auth-panel">
        <form class="auth-form" asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
            <div>
                <h2>Ορίστε νέο κωδικό</h2>
                <p>Μετά την αποθήκευση θα ανακατευθυνθείτε στη σελίδα εισόδου.</p>
            </div>
            <div asp-validation-summary="All" class="validation-summary"></div>
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div class="field">
                <label asp-for="NewPassword" class="field-label">Νέος κωδικός</label>
                <input asp-for="NewPassword" class="form-input" type="password" autocomplete="new-password" placeholder="••••••••••" autofocus />
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword" class="field-label">Επιβεβαίωση κωδικού</label>
                <input asp-for="ConfirmPassword" class="form-input" type="password" autocomplete="new-password" placeholder="••••••••••" />
            </div>
            <button class="btn btn-lg" type="submit">Αποθήκευση νέου κωδικού <i class="fa-solid fa-arrow-right"></i></button>
        </form>
    </section>
</div>
