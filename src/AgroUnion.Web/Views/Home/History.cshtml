@{ ViewData["Title"] = "Η ιστορία μας"; }

<section class="hero-photo" style="--hero-img:url(/images/photography/hero-work.jpg)">
    <div class="container">
        <div class="overline">Η διαδρομή μας</div>
        <h1>Μια τοπική ανάγκη. Ένα κοινό όραμα.</h1>
        <p class="lead">Η AGRO UNION γεννήθηκε στην Αιτωλοακαρνανία για να δώσει οργάνωση, διαφάνεια και εμπορική δύναμη σε μια αγορά με μεγάλη παραγωγική αξία.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-header">
            <div class="head-copy">
                <div class="overline">Γιατί δημιουργηθήκαμε</div>
                <h2>Ο τόπος είχε την παραγωγή. Χρειαζόταν τη σύνδεση.</h2>
            </div>
            <p class="head-side">Η αφετηρία μας ήταν μια απλή διαπίστωση: όταν παραγωγή, εμπόριο και οργανωμένη ζήτηση κινούνται αποσπασματικά, χάνεται αξία για όλους. Η AGRO UNION δημιουργήθηκε ως trading και coordination house, ώστε να συνδέει τα δύο άκρα της αγοράς με καθαρούς όρους, γραπτές συμφωνίες και πραγματική παρακολούθηση κάθε συναλλαγής.</p>
        </div>

        <div class="timeline">
            <div class="timeline-item">
                <time>01 · Η ανάγκη</time>
                <h3>Κατακερματισμένη παραγωγή</h3>
                <p>Πολλοί παραγωγοί, διαφορετικές ανάγκες και περιορισμένη συλλογική διαπραγματευτική ισχύς.</p>
            </div>
            <div class="timeline-item">
                <time>02 · Η ιδέα</time>
                <h3>Ένα ενιαίο δίκτυο</h3>
                <p>Συγκέντρωση όγκου, οργάνωση της πληροφορίας και συντονισμός αξιόπιστων συνεργασιών.</p>
            </div>
            <div class="timeline-item">
                <time>2026 · Η ίδρυση</time>
                <h3>Η AGRO UNION παίρνει μορφή</h3>
                <p>Με βάση το Μεσολόγγι, ξεκινά η δημιουργία μιας σύγχρονης εμπορικής υποδομής για την περιοχή.</p>
            </div>
            <div class="timeline-item">
                <time>04 · Το επόμενο κεφάλαιο</time>
                <h3>Ανάπτυξη με σταθερές αρχές</h3>
                <p>Περισσότερες περιοχές, συνεργάτες και προϊόντα, με την ίδια προσήλωση στη διαφάνεια και τη συνέπεια.</p>
            </div>
        </div>
    </div>
</section>

<section class="section section-paper">
    <div class="container">
        <div class="grid grid-3">
            <a class="feature-card" asp-action="Team">
                <div class="feature-icon"><i class="fa-solid fa-users"></i></div>
                <h3>Οι άνθρωποι</h3>
                <p>Γνωρίστε την ομάδα και τους ρόλους ευθύνης.</p>
                <span class="btn-link">Η ομάδα <i class="fa-solid fa-arrow-right"></i></span>
            </a>
            <a class="feature-card" asp-action="Vision">
                <div class="feature-icon"><i class="fa-solid fa-binoculars"></i></div>
                <h3>Η κατεύθυνση</h3>
                <p>Δείτε το όραμα και τις αρχές μας.</p>
                <span class="btn-link">Όραμα & αξίες <i class="fa-solid fa-arrow-right"></i></span>
            </a>
            <a class="feature-card" asp-action="Network">
                <div class="feature-icon"><i class="fa-solid fa-map-location-dot"></i></div>
                <h3>Ο τόπος</h3>
                <p>Εξερευνήστε τις περιοχές του δικτύου.</p>
                <span class="btn-link">Το δίκτυο <i class="fa-solid fa-arrow-right"></i></span>
            </a>
        </div>
    </div>
</section>

<section class="cta-band">
    <div class="container">
        <div class="side">
            <div class="cta-icon"><i class="fa-solid fa-pen-nib"></i></div>
            <div>
                <div class="overline plain">Γράψτε το επόμενο κεφάλαιο μαζί μας</div>
                <h2>Η ιστορία ενός δικτύου γράφεται από τους ανθρώπους του.</h2>
            </div>
        </div>
        <div class="side">
            <a class="btn btn-lg" asp-action="Apply">Γίνετε μέρος της <i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </div>
</section>
