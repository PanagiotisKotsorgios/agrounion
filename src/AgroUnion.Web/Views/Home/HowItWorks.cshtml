@{ ViewData["Title"] = "Πώς λειτουργεί"; }

<section class="hero-photo" style="--hero-img:url(/images/photography/hero-signing.jpg)">
    <div class="container-wide">
        <div class="overline">Η διαδικασία</div>
        <h1>Κάθε συνεργασία έχει<br />ξεκάθαρη πορεία.</h1>
        <p class="lead">Από την πρώτη αίτηση έως την ολοκλήρωση της συναλλαγής, γνωρίζετε πάντα το επόμενο βήμα.</p>
        <div class="hero-actions">
            <a class="btn btn-lg btn-brass" asp-action="Apply">Ξεκινήστε τώρα <i class="fa-solid fa-arrow-right"></i></a>
            <a class="btn btn-lg btn-outline-light" asp-action="Contracts">Δείτε τους όρους</a>
        </div>
    </div>
</section>

<section class="section process-section">
    <div class="container">
        <header class="process-intro">
            <div>
                <div class="overline">Πλαίσιο συνεργασίας</div>
                <h2>Τέσσερα στάδια.<br />Σαφείς ευθύνες.</h2>
            </div>
            <p>Η πορεία κάθε συνεργασίας ακολουθεί συγκεκριμένα στάδια, με καθαρό αποτέλεσμα και ενημέρωση σε κάθε σημείο μετάβασης.</p>
        </header>

        <ol class="corporate-process">
            <li class="process-row">
                <div class="process-index"><strong>01</strong><span>Αίτηση</span></div>
                <div class="process-copy">
                    <div class="process-kicker">Εκδήλωση ενδιαφέροντος</div>
                    <h3>Μας συστήνεστε.</h3>
                    <p>Συμπληρώνετε τον ρόλο, την περιοχή, το προϊόν ή το αντικείμενο που σας ενδιαφέρει. Η αίτηση αποθηκεύεται με ασφάλεια και φτάνει στην ομάδα μας.</p>
                </div>
                <dl class="process-meta">
                    <div><dt>Καταγραφή</dt><dd>Ρόλος · Περιοχή · Αντικείμενο</dd></div>
                    <div><dt>Αποτέλεσμα</dt><dd>Αίτηση προς αξιολόγηση</dd></div>
                </dl>
            </li>

            <li class="process-row">
                <div class="process-index"><strong>02</strong><span>Αξιολόγηση</span></div>
                <div class="process-copy">
                    <div class="process-kicker">Αξιολόγηση &amp; όροι</div>
                    <h3>Σχεδιάζουμε τη συνεργασία.</h3>
                    <p>Συζητάμε την πραγματική ανάγκη, επιβεβαιώνουμε το μοντέλο συνεργασίας και διαμορφώνουμε τους εμπορικούς και λειτουργικούς όρους.</p>
                </div>
                <dl class="process-meta">
                    <div><dt>Διαδικασία</dt><dd>Προσωπική επαφή · Επιβεβαίωση όρων</dd></div>
                    <div><dt>Αποτέλεσμα</dt><dd>Εγκεκριμένο πλαίσιο συνεργασίας</dd></div>
                </dl>
            </li>

            <li class="process-row">
                <div class="process-index"><strong>03</strong><span>Ενεργοποίηση</span></div>
                <div class="process-copy">
                    <div class="process-kicker">Λογαριασμός &amp; σύμβαση</div>
                    <h3>Ενεργοποιούμε τα εργαλεία.</h3>
                    <p>Δημιουργείται ο λογαριασμός σας, λαμβάνετε προσωρινό κωδικό και βλέπετε τη σύμβαση στο προσωπικό σας portal.</p>
                </div>
                <dl class="process-meta">
                    <div><dt>Ενεργοποίηση</dt><dd>Πρόσκληση · Ασφαλής είσοδος</dd></div>
                    <div><dt>Αποτέλεσμα</dt><dd>Λογαριασμός και σύμβαση</dd></div>
                </dl>
            </li>

            <li class="process-row">
                <div class="process-index"><strong>04</strong><span>Λειτουργία</span></div>
                <div class="process-copy">
                    <div class="process-kicker">Καθημερινή συνεργασία</div>
                    <h3>Προχωράμε με πλήρη εικόνα.</h3>
                    <p>Δηλώσεις, προσφορές, επιβεβαιώσεις, παραλαβές και συναλλαγές κινούνται μέσα σε μία ενιαία, καταγεγραμμένη ροή.</p>
                </div>
                <dl class="process-meta">
                    <div><dt>Λειτουργία</dt><dd>Ενέργειες · Ειδοποιήσεις · Ιστορικό</dd></div>
                    <div><dt>Κατάσταση</dt><dd>Ενεργή συνεργασία</dd></div>
                </dl>
            </li>
        </ol>
    </div>
</section>

<section class="section section-paper">
    <div class="container">
        <div class="section-header">
            <div class="head-copy">
                <div class="overline">Δύο μοντέλα</div>
                <h2>Η σωστή επιλογή κάθε φορά.</h2>
            </div>
        </div>
        <div class="grid grid-2">
            <article class="card">
                <div class="card-body">
                    <div class="feature-icon"><i class="fa-solid fa-arrow-right-arrow-left"></i></div>
                    <div class="overline" style="margin-top:16px">Brokerage</div>
                    <h3 style="margin-top:8px">Αγορά &amp; μεταπώληση</h3>
                    <p>Η AGRO UNION αγοράζει και μεταπωλεί, αναλαμβάνοντας τα δύο σκέλη της συναλλαγής.</p>
                </div>
            </article>
            <article class="card">
                <div class="card-body">
                    <div class="feature-icon"><i class="fa-solid fa-people-arrows-left-right"></i></div>
                    <div class="overline" style="margin-top:16px">Facilitation</div>
                    <h3 style="margin-top:8px">Απλή διευκόλυνση</h3>
                    <p>Συντονισμός συλλογικής ανάγκης χωρίς αγορά και μεταπώληση από την εταιρεία.</p>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="cta-band">
    <div class="container">
        <div class="side">
            <div class="cta-icon"><i class="fa-solid fa-route"></i></div>
            <div>
                <div class="overline plain">Έτοιμοι για το επόμενο βήμα;</div>
                <h2>Ξεκινήστε τη διαδρομή σας στο δίκτυο.</h2>
            </div>
        </div>
        <div class="side">
            <a class="btn btn-lg" asp-action="Apply">Αίτηση συνεργασίας <i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </div>
</section>
