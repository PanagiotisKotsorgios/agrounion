@{ ViewData["Title"] = "Πώς λειτουργεί"; }

<section class="hero-photo" style="--hero-img:url(/images/photography/hero-signing.jpg)">
    <div class="container-wide">
        <div class="overline">Η διαδικασία</div>
        <h1>Κάθε συνεργασία έχει<br />ξεκάθαρη πορεία.</h1>
        <p class="lead">Από την πρώτη αίτηση έως την ολοκλήρωση της συναλλαγής, γνωρίζετε πάντα το επόμενο βήμα.</p>
        <div class="hero-actions">
            <a class="btn btn-lg btn-brass" asp-action="Apply">Ξεκινήστε τώρα <i class="fa-solid fa-arrow-right"></i></a>
            <a class="btn btn-lg btn-outline-light" asp-action="Contracts">Δείτε τους όρους</a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="stack-lg">
            <div class="card">
                <div class="card-body" style="display:grid;grid-template-columns:auto 1fr auto;gap:24px;align-items:flex-start">
                    <div style="width:56px;height:56px;background:var(--green-700);color:#fff;border-radius:12px;display:grid;place-items:center;font-family:var(--mono);font-weight:700;font-size:18px">01</div>
                    <div>
                        <div class="overline">Εκδήλωση ενδιαφέροντος</div>
                        <h2 style="margin-top:12px">Μας συστήνεστε.</h2>
                        <p>Συμπληρώνετε τον ρόλο, την περιοχή, το προϊόν ή το αντικείμενο που σας ενδιαφέρει. Η αίτηση αποθηκεύεται με ασφάλεια και φτάνει στην ομάδα μας.</p>
                        <div style="display:flex;gap:8px;flex-wrap:wrap">
                            <span class="badge"><i class="fa-solid fa-user-tag"></i> Ρόλος</span>
                            <span class="badge"><i class="fa-solid fa-location-dot"></i> Περιοχή</span>
                            <span class="badge"><i class="fa-solid fa-wheat-awn"></i> Προϊόν</span>
                        </div>
                    </div>
                    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px">
                        <i class="fa-solid fa-inbox" style="font-size:32px;color:var(--green-600)"></i>
                        <span class="status-pill pending">Σε αξιολόγηση</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body" style="display:grid;grid-template-columns:auto 1fr auto;gap:24px;align-items:flex-start">
                    <div style="width:56px;height:56px;background:var(--brass-500);color:#fff;border-radius:12px;display:grid;place-items:center;font-family:var(--mono);font-weight:700;font-size:18px">02</div>
                    <div>
                        <div class="overline">Αξιολόγηση & όροι</div>
                        <h2 style="margin-top:12px">Σχεδιάζουμε τη συνεργασία.</h2>
                        <p>Συζητάμε την πραγματική ανάγκη, επιβεβαιώνουμε το μοντέλο συνεργασίας και διαμορφώνουμε τους εμπορικούς και λειτουργικούς όρους.</p>
                        <div style="display:flex;gap:8px;flex-wrap:wrap">
                            <span class="badge"><i class="fa-solid fa-phone"></i> Προσωπική επαφή</span>
                            <span class="badge"><i class="fa-solid fa-scale-balanced"></i> Όροι</span>
                            <span class="badge"><i class="fa-solid fa-circle-check"></i> Έγκριση</span>
                        </div>
                    </div>
                    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px">
                        <i class="fa-solid fa-handshake" style="font-size:32px;color:var(--brass-500)"></i>
                        <span class="status-pill active">Εγκεκριμένη</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body" style="display:grid;grid-template-columns:auto 1fr auto;gap:24px;align-items:flex-start">
                    <div style="width:56px;height:56px;background:var(--green-600);color:#fff;border-radius:12px;display:grid;place-items:center;font-family:var(--mono);font-weight:700;font-size:18px">03</div>
                    <div>
                        <div class="overline">Λογαριασμός & σύμβαση</div>
                        <h2 style="margin-top:12px">Ενεργοποιούμε τα εργαλεία.</h2>
                        <p>Δημιουργείται ο λογαριασμός σας, λαμβάνετε προσωρινό κωδικό και βλέπετε τη σύμβαση στο προσωπικό σας portal.</p>
                        <div style="display:flex;gap:8px;flex-wrap:wrap">
                            <span class="badge"><i class="fa-solid fa-envelope-open-text"></i> Πρόσκληση</span>
                            <span class="badge"><i class="fa-solid fa-user-lock"></i> Ασφαλής είσοδος</span>
                            <span class="badge"><i class="fa-solid fa-file-contract"></i> Σύμβαση</span>
                        </div>
                    </div>
                    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px">
                        <i class="fa-solid fa-user-check" style="font-size:32px;color:var(--green-600)"></i>
                        <span class="status-pill active">Συνδεδεμένος</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body" style="display:grid;grid-template-columns:auto 1fr auto;gap:24px;align-items:flex-start">
                    <div style="width:56px;height:56px;background:var(--green-900);color:#fff;border-radius:12px;display:grid;place-items:center;font-family:var(--mono);font-weight:700;font-size:18px">04</div>
                    <div>
                        <div class="overline">Καθημερινή συνεργασία</div>
                        <h2 style="margin-top:12px">Προχωράμε με πλήρη εικόνα.</h2>
                        <p>Δηλώσεις, προσφορές, επιβεβαιώσεις, παραλαβές και συναλλαγές κινούνται μέσα σε μία ενιαία, καταγεγραμμένη ροή.</p>
                        <div style="display:flex;gap:8px;flex-wrap:wrap">
                            <span class="badge"><i class="fa-solid fa-list-check"></i> Ενέργειες</span>
                            <span class="badge"><i class="fa-solid fa-bell"></i> Ειδοποιήσεις</span>
                            <span class="badge"><i class="fa-solid fa-clock-rotate-left"></i> Ιστορικό</span>
                        </div>
                    </div>
                    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px">
                        <i class="fa-solid fa-chart-line" style="font-size:32px;color:var(--green-800)"></i>
                        <span class="status-pill active">Live</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section-paper">
    <div class="container">
        <div class="section-header">
            <div class="head-copy">
                <div class="overline">Δύο μοντέλα</div>
                <h2>Η σωστή επιλογή κάθε φορά.</h2>
            </div>
        </div>
        <div class="grid grid-2">
            <article class="card">
                <div class="card-body">
                    <div class="feature-icon"><i class="fa-solid fa-arrow-right-arrow-left"></i></div>
                    <div class="overline" style="margin-top:16px">Brokerage</div>
                    <h3 style="margin-top:8px">Αγορά & μεταπώληση</h3>
                    <p>Η AGRO UNION αγοράζει και μεταπωλεί, αναλαμβάνοντας τα δύο σκέλη της συναλλαγής.</p>
                </div>
            </article>
            <article class="card">
                <div class="card-body">
                    <div class="feature-icon"><i class="fa-solid fa-people-arrows-left-right"></i></div>
                    <div class="overline" style="margin-top:16px">Facilitation</div>
                    <h3 style="margin-top:8px">Απλή διευκόλυνση</h3>
                    <p>Συντονισμός συλλογικής ανάγκης χωρίς αγορά και μεταπώληση από την εταιρεία.</p>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="cta-band">
    <div class="container">
        <div class="side">
            <div class="cta-icon"><i class="fa-solid fa-route"></i></div>
            <div>
                <div class="overline plain">Έτοιμοι για το επόμενο βήμα;</div>
                <h2>Ξεκινήστε τη διαδρομή σας στο δίκτυο.</h2>
            </div>
        </div>
        <div class="side">
            <a class="btn btn-lg" asp-action="Apply">Αίτηση συνεργασίας <i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </div>
</section>
