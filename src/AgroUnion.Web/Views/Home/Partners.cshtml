@{ ViewData["Title"] = "Για συνεργάτες"; }

<section class="hero-photo" style="--hero-img:url(/images/photography/hero-team.jpg);min-height:540px">
    <div class="container">
        <div class="overline">Ένα δίκτυο, πολλοί ρόλοι</div>
        <h1>Το σωστό εργαλείο για κάθε συνεργάτη.</h1>
        <p class="lead">Διαφορετικές ανάγκες, ξεχωριστή πρόσβαση και μία κοινή, αξιόπιστη εμπορική ροή.</p>
    </div>
</section>

<section class="section" id="producers">
    <div class="container">
        <div class="section-header">
            <div class="head-copy">
                <div class="overline">01 · Παραγωγός</div>
                <h2>Η παραγωγή σας, με μεγαλύτερη δύναμη.</h2>
            </div>
            <p class="head-side">Δηλώνετε με ακρίβεια ό,τι έχετε διαθέσιμο και λαμβάνετε ξεκάθαρες προσφορές αγοράς από την AGRO UNION.</p>
        </div>
        <div class="grid grid-2">
            <article class="card"><div class="card-body" style="display:flex;gap:16px;align-items:flex-start"><div class="feature-icon"><i class="fa-solid fa-wheat-awn"></i></div><div><h3 style="margin:0 0 6px">Δήλωση παραγωγής</h3><p style="margin:0" class="text-muted">Προϊόν, ποσότητα, ποιότητα και διαθεσιμότητα.</p></div></div></article>
            <article class="card"><div class="card-body" style="display:flex;gap:16px;align-items:flex-start"><div class="feature-icon"><i class="fa-solid fa-tags"></i></div><div><h3 style="margin:0 0 6px">Προσφορές αγοράς</h3><p style="margin:0" class="text-muted">Βλέπετε μόνο την τιμή που προσφέρεται σε εσάς.</p></div></div></article>
            <article class="card"><div class="card-body" style="display:flex;gap:16px;align-items:flex-start"><div class="feature-icon"><i class="fa-solid fa-boxes-stacked"></i></div><div><h3 style="margin:0 0 6px">Συλλογικές παραγγελίες</h3><p style="margin:0" class="text-muted">Συμμετέχετε εύκολα δηλώνοντας την ποσότητά σας.</p></div></div></article>
            <article class="card"><div class="card-body" style="display:flex;gap:16px;align-items:flex-start"><div class="feature-icon"><i class="fa-solid fa-clock-rotate-left"></i></div><div><h3 style="margin:0 0 6px">Προσωπικό ιστορικό</h3><p style="margin:0" class="text-muted">Σύμβαση και buy-side συναλλαγές σε μία εικόνα.</p></div></div></article>
        </div>
        <div class="mt-8">
            <a class="btn" asp-action="Apply"><i class="fa-solid fa-plus"></i> Αίτηση ως παραγωγός <i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </div>
</section>

<section class="section section-paper" id="traders">
    <div class="container">
        <div class="section-header">
            <div class="head-copy">
                <div class="overline">02 · Έμπορος</div>
                <h2>Πρόσβαση σε όγκο. Χωρίς περιττή πληροφορία.</h2>
            </div>
            <p class="head-side">Βλέπετε τη διαθέσιμη δυναμικότητα του δικτύου και τις εμπορικές προτάσεις που απευθύνονται αποκλειστικά σε εσάς.</p>
        </div>
        <div class="grid grid-2">
            <article class="card"><div class="card-body" style="display:flex;gap:16px;align-items:flex-start"><div class="feature-icon"><i class="fa-solid fa-chart-area"></i></div><div><h3 style="margin:0 0 6px">Διαθέσιμος όγκος</h3><p style="margin:0" class="text-muted">Συγκεντρωτική εικόνα ανά προϊόν και περιοχή.</p></div></div></article>
            <article class="card"><div class="card-body" style="display:flex;gap:16px;align-items:flex-start"><div class="feature-icon"><i class="fa-solid fa-tag"></i></div><div><h3 style="margin:0 0 6px">Προσφορές πώλησης</h3><p style="margin:0" class="text-muted">Τελική τιμή AGRO UNION και δυνατότητα αντιπροσφοράς.</p></div></div></article>
            <article class="card"><div class="card-body" style="display:flex;gap:16px;align-items:flex-start"><div class="feature-icon"><i class="fa-solid fa-truck-fast"></i></div><div><h3 style="margin:0 0 6px">Παραλαβές</h3><p style="margin:0" class="text-muted">Προγραμματισμός και μεταφορικές λεπτομέρειες.</p></div></div></article>
            <article class="card"><div class="card-body" style="display:flex;gap:16px;align-items:flex-start"><div class="feature-icon"><i class="fa-solid fa-file-export"></i></div><div><h3 style="margin:0 0 6px">Αναφορές</h3><p style="margin:0" class="text-muted">Sell-side ιστορικό και εξαγωγή συναλλαγών.</p></div></div></article>
        </div>
        <div class="mt-8">
            <a class="btn" asp-action="Apply"><i class="fa-solid fa-plus"></i> Αίτηση ως έμπορος <i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </div>
</section>

<section class="section" id="companies">
    <div class="container">
        <div class="section-header">
            <div class="head-copy">
                <div class="overline">03 · Συνεργαζόμενη εταιρεία</div>
                <h2>Προγραμματισμός που βλέπει πιο μπροστά.</h2>
            </div>
            <p class="head-side">Εργοστάσια, τυποποιητές και προμηθευτές αποκτούν εικόνα μελλοντικής διαθεσιμότητας και οργανωμένη πρόσβαση στο δίκτυο.</p>
        </div>
        <div class="grid grid-2">
            <article class="card"><div class="card-body" style="display:flex;gap:16px;align-items:flex-start"><div class="feature-icon"><i class="fa-solid fa-calendar-days"></i></div><div><h3 style="margin:0 0 6px">Forecast προμήθειας</h3><p style="margin:0" class="text-muted">Προβλεπόμενος όγκος ανά περίοδο και περιοχή.</p></div></div></article>
            <article class="card"><div class="card-body" style="display:flex;gap:16px;align-items:flex-start"><div class="feature-icon"><i class="fa-solid fa-receipt"></i></div><div><h3 style="margin:0 0 6px">Τιμοκατάλογοι</h3><p style="margin:0" class="text-muted">Προσφορές προϊόντων ή δημοσίευση εφοδίων.</p></div></div></article>
            <article class="card"><div class="card-body" style="display:flex;gap:16px;align-items:flex-start"><div class="feature-icon"><i class="fa-solid fa-file-contract"></i></div><div><h3 style="margin:0 0 6px">Ενεργές συμβάσεις</h3><p style="margin:0" class="text-muted">Όροι συνεργασίας πάντα διαθέσιμοι.</p></div></div></article>
            <article class="card"><div class="card-body" style="display:flex;gap:16px;align-items:flex-start"><div class="feature-icon"><i class="fa-solid fa-chart-pie"></i></div><div><h3 style="margin:0 0 6px">Εμπορικό ιστορικό</h3><p style="margin:0" class="text-muted">Sell-side συναλλαγές και φίλτρα αναφορών.</p></div></div></article>
        </div>
        <div class="mt-8">
            <a class="btn" asp-action="Apply"><i class="fa-solid fa-plus"></i> Αίτηση ως εταιρεία <i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </div>
</section>

<section class="cta-band">
    <div class="container">
        <div class="side">
            <div class="cta-icon"><i class="fa-solid fa-people-group"></i></div>
            <div>
                <div class="overline plain">Ένα δίκτυο, τρεις ρόλοι</div>
                <h2>Επιλέξτε τη θέση σας και ξεκινήστε.</h2>
            </div>
        </div>
        <div class="side">
            <a class="btn btn-lg" asp-action="Apply">Νέα αίτηση συνεργασίας <i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </div>
</section>
