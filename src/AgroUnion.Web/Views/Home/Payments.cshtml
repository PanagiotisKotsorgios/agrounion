@{ ViewData["Title"] = "Πληρωμές & Εξοφλήσεις"; }

<section class="hero-photo" style="--hero-img:url(/images/photography/hero-contract.jpg);min-height:min(560px,68vh);padding:96px 0 80px">
    <div class="container-wide">
        <div class="overline">Στοιχεία πληρωμής</div>
        <h1>Πληρωμές &amp; Εξοφλήσεις</h1>
        <p class="lead">Ασφαλείς τραπεζικοί λογαριασμοί και IRIS για κάθε συνεργάτη της AGRO UNION. Επιλέξτε τον τρόπο που σας εξυπηρετεί.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="pay-header">
            <div class="pay-header-mark">
                <img src="~/images/agro-union-logo.png" alt="AGRO UNION" />
            </div>
            <div>
                <div class="overline">AGRO UNION · Στοιχεία τραπεζών</div>
                <h2 class="pay-title">Στοιχεία Πληρωμής</h2>
                <p class="text-muted" style="max-width:760px;margin-top:12px">Επιλέξτε έναν από τους δύο τραπεζικούς λογαριασμούς ή τη μέθοδο IRIS. Πριν ολοκληρώσετε την πληρωμή, ελέγξτε προσεκτικά τα στοιχεία και συμπληρώστε την αιτιολογία.</p>
            </div>
        </div>

        <article class="payment-table-card">
            <table class="payment-overview">
                <caption class="sr-only">Τραπεζικοί λογαριασμοί και στοιχεία πληρωμής IRIS</caption>
                <thead>
                    <tr>
                        <th scope="col">Μέθοδος</th>
                        <th scope="col">Δικαιούχος</th>
                        <th scope="col">IBAN / Κινητό</th>
                        <th scope="col">SWIFT / ΑΦΜ</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th scope="row">
                            <span class="payment-method">
                                <span class="payment-method-icon"><i class="fa-solid fa-building-columns"></i></span>
                                <span><strong>Λογαριασμός 1</strong><small>Τράπεζα Πειραιώς</small></span>
                            </span>
                        </th>
                        <td data-label="Δικαιούχος"><strong>ΠΑΝΑΓΙΩΤΗΣ ΚΟΤΣΟΡΓΙΟΣ</strong></td>
                        <td data-label="IBAN">
                            <span class="payment-number">
                                <strong>GR18 0172 1610 0051 6111 8162 881</strong>
                                <button type="button" class="copy-btn" data-copy="GR1801721610005161118162881" aria-label="Αντιγραφή IBAN λογαριασμού 1"><i class="fa-regular fa-copy"></i> Αντιγραφή</button>
                            </span>
                        </td>
                        <td data-label="SWIFT / BIC"><span class="payment-reference"><small>SWIFT / BIC</small><strong>PIRBGRAA</strong></span></td>
                    </tr>
                    <tr>
                        <th scope="row">
                            <span class="payment-method">
                                <span class="payment-method-icon"><i class="fa-solid fa-building-columns"></i></span>
                                <span><strong>Λογαριασμός 2</strong><small>Τράπεζα Πειραιώς</small></span>
                            </span>
                        </th>
                        <td data-label="Δικαιούχος"><strong>ΠΑΝΑΓΙΩΤΗΣ ΚΟΤΣΟΡΓΙΟΣ</strong></td>
                        <td data-label="IBAN">
                            <span class="payment-number">
                                <strong>GR94 0172 1610 0051 6110 9856 179</strong>
                                <button type="button" class="copy-btn" data-copy="GR9401721610005161109856179" aria-label="Αντιγραφή IBAN λογαριασμού 2"><i class="fa-regular fa-copy"></i> Αντιγραφή</button>
                            </span>
                        </td>
                        <td data-label="SWIFT / BIC"><span class="payment-reference"><small>SWIFT / BIC</small><strong>PIRBGRAA</strong></span></td>
                    </tr>
                    <tr class="iris-row">
                        <th scope="row">
                            <span class="payment-method">
                                <span class="payment-method-icon"><i class="fa-solid fa-mobile-screen-button"></i></span>
                                <span><strong>IRIS Πληρωμή</strong><small>Μέσω κινητού</small></span>
                            </span>
                        </th>
                        <td data-label="Όνομα"><strong>ΠΑΝΑΓΙΩΤΗΣ ΚΟΤΣΟΡΓΙΟΣ</strong></td>
                        <td data-label="Κινητό">
                            <span class="payment-number">
                                <strong>6986788178</strong>
                                <button type="button" class="copy-btn" data-copy="6986788178" aria-label="Αντιγραφή αριθμού IRIS"><i class="fa-regular fa-copy"></i> Αντιγραφή</button>
                            </span>
                        </td>
                        <td data-label="ΑΦΜ"><span class="payment-reference"><small>ΑΦΜ</small><strong>176091030</strong></span></td>
                    </tr>
                </tbody>
            </table>
        </article>

        <section class="payment-guidance" aria-labelledby="payment-guidance-title">
            <header class="payment-guidance-head">
                <div>
                    <div class="overline">Οδηγία κατάθεσης</div>
                    <h3 id="payment-guidance-title">Αιτιολογία πληρωμής</h3>
                </div>
                <p>Για την άμεση αναγνώριση της πληρωμής, χρησιμοποιήστε το παρακάτω πρότυπο στην τραπεζική εντολή.</p>
            </header>
            <div class="payment-reference-template">
                <span>Πρότυπο αιτιολογίας</span>
                <code>Πληρωμή συνεργάτη &lt;ΟΝΟΜΑ ΕΤΑΙΡΕΙΑΣ&gt; προς AGRO UNION · &lt;Αιτιολογία&gt;</code>
                <button type="button" class="copy-btn" data-copy="Πληρωμή συνεργάτη <ΟΝΟΜΑ ΕΤΑΙΡΕΙΑΣ> προς AGRO UNION · <Αιτιολογία>" aria-label="Αντιγραφή προτύπου"><i class="fa-regular fa-copy"></i> Αντιγραφή προτύπου</button>
            </div>
            <ol class="payment-guidance-list">
                <li><span>01</span><p>Αντικαταστήστε το <strong>&lt;ΟΝΟΜΑ ΕΤΑΙΡΕΙΑΣ&gt;</strong> με την πλήρη επωνυμία της εταιρείας σας.</p></li>
                <li><span>02</span><p>Στην <strong>&lt;Αιτιολογία&gt;</strong> αναφέρετε τον σκοπό: τιμολόγιο, εκκαθάριση ή προκαταβολή.</p></li>
                <li><span>03</span><p>Στείλτε το αποδεικτικό πληρωμής στο <a href="mailto:info@agro-union.gr">info@agro-union.gr</a>.</p></li>
            </ol>
        </section>

        <div class="payment-contact">
            <div>
                <div class="overline plain">Υποστήριξη πληρωμών</div>
                <strong>Χρειάζεστε διευκρίνιση πριν την κατάθεση;</strong>
                <p>Η ομάδα μας μπορεί να επιβεβαιώσει τα στοιχεία και την αιτιολογία πριν πραγματοποιήσετε την πληρωμή.</p>
            </div>
            <a class="btn" asp-controller="Home" asp-action="Contact">Επικοινωνία <i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </div>
</section>

@section Scripts {
<script>
document.querySelectorAll('.copy-btn').forEach(btn => btn.addEventListener('click', async () => {
    const text = btn.dataset.copy;
    if (!text) return;
    try {
        await navigator.clipboard.writeText(text);
        const original = btn.innerHTML;
        btn.innerHTML = '<i class="fa-solid fa-check"></i> Αντιγράφηκε';
        btn.classList.add('copied');
        setTimeout(() => { btn.innerHTML = original; btn.classList.remove('copied'); }, 1600);
    } catch (e) {
        btn.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Απέτυχε';
        setTimeout(() => { btn.innerHTML = '<i class="fa-regular fa-copy"></i> Αντιγραφή'; }, 1600);
    }
}));
</script>
}
