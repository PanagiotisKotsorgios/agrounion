@{ ViewData["Title"] = "Πολιτική απορρήτου"; }

<section class="hero-photo" style="--hero-img:url(/images/photography/hero-office.jpg);min-height:min(560px,68vh);padding:96px 0 80px">
    <div class="container-wide">
        <div class="overline">Προσωπικά δεδομένα</div>
        <h1>Η πληροφορία σας<br />παραμένει προστατευμένη.</h1>
        <p class="lead">Συλλέγουμε μόνο όσα είναι απαραίτητα και τα χρησιμοποιούμε με σαφή σκοπό.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="split">
            <aside class="aside">
                <div class="card">
                    <div class="card-body">
                        <div class="overline">Ενότητες</div>
                        <ul style="list-style:none;padding:0;margin:16px 0 0;display:flex;flex-direction:column;gap:8px">
                            <li><a class="btn-link" href="#purpose"><i class="fa-solid fa-bullseye"></i> Σκοπός επεξεργασίας</a></li>
                            <li><a class="btn-link" href="#rights"><i class="fa-solid fa-scale-balanced"></i> Τα δικαιώματά σας</a></li>
                            <li><a class="btn-link" href="#security"><i class="fa-solid fa-shield-halved"></i> Μέτρα ασφάλειας</a></li>
                            <li><a class="btn-link" href="#contact-data"><i class="fa-solid fa-envelope"></i> Επικοινωνία</a></li>
                        </ul>
                    </div>
                </div>
            </aside>
            <article class="stack-lg">
                <section id="purpose" class="card">
                    <div class="card-body">
                        <div class="overline">01 · Σκοπός</div>
                        <h2 style="margin-top:12px">Σκοπός και νόμιμη βάση</h2>
                        <p>Η AGRO UNION επεξεργάζεται μόνο τα στοιχεία που είναι απαραίτητα για την αξιολόγηση αιτήσεων συνεργασίας, την επικοινωνία και την εκτέλεση συμβάσεων.</p>
                        <p>Τα στοιχεία αίτησης χρησιμοποιούνται για προσυμβατική επικοινωνία κατόπιν αιτήματός σας. Τα δεδομένα συνεργατών τηρούνται για την εκτέλεση της σύμβασης και τις νόμιμες φορολογικές υποχρεώσεις.</p>
                    </div>
                </section>
                <section id="rights" class="card">
                    <div class="card-body">
                        <div class="overline">02 · Δικαιώματα</div>
                        <h2 style="margin-top:12px">Τα δικαιώματά σας</h2>
                        <p>Μπορείτε να ζητήσετε πρόσβαση, διόρθωση, περιορισμό ή διαγραφή προσωπικών δεδομένων. Όπου υφίσταται νόμιμη υποχρέωση τήρησης, τα δεδομένα περιορίζονται και διαγράφονται μετά τη λήξη της.</p>
                    </div>
                </section>
                <section id="security" class="card">
                    <div class="card-body">
                        <div class="overline">03 · Ασφάλεια</div>
                        <h2 style="margin-top:12px">Μέτρα ασφάλειας</h2>
                        <p>Εφαρμόζουμε έλεγχο πρόσβασης ανά ρόλο, κρυπτογραφημένη μεταφορά, ασφαλή cookies, καταγραφή κρίσιμων ενεργειών και ελάχιστη αναγκαία έκθεση εμπορικών δεδομένων.</p>
                    </div>
                </section>
                <section id="contact-data" class="card">
                    <div class="card-body">
                        <div class="overline">04 · Επικοινωνία</div>
                        <h2 style="margin-top:12px">Αιτήματα δεδομένων</h2>
                        <p>Για οποιοδήποτε αίτημα σχετικό με τα προσωπικά σας δεδομένα, επικοινωνήστε στο <a class="btn-link" href="mailto:info@agro-union.gr">info@agro-union.gr</a>.</p>
                    </div>
                </section>
            </article>
        </div>
    </div>
</section>
