@model object
@using AgroUnion.Application.Contracts
@using AgroUnion.Domain.Entities
@{
    var role = User.IsInRole(RoleNames.Admin) ? "Διαχείριση" : User.IsInRole(RoleNames.Producer) ? "Παραγωγός" : User.IsInRole(RoleNames.Trader) ? "Έμπορος" : "Εταιρεία";
    var producerPage = (ViewData["ProducerPage"] as string ?? "overview").ToLowerInvariant();
    var adminPage = (ViewData["AdminPage"] as string ?? "overview").ToLowerInvariant();
    var portalPage = (ViewData["PortalPage"] as string ?? "overview").ToLowerInvariant();
    var isMarketplace = portalPage == "marketplace";
    var isProfile = portalPage == "profile";
    var marketplaceEnabled = ViewData["MarketplaceEnabled"] as bool? ?? false;
    var maintenanceNotice = ViewData["MaintenanceNotice"] as string;
    var pageTitle = producerPage switch
    {
        "collaboration" => "Η συνεργασία μου",
        "finances" => "Οικονομική εικόνα",
        "production" => "Παραγωγή & παραδόσεις",
        "logistics" => "Δρομολόγια",
        "invoices" => "Τιμολόγια",
        "documents" => "Έγγραφα",
        "offers" => "Προσφορές",
        _ => "Επισκόπηση"
    };
    var pageDescription = producerPage switch
    {
        "collaboration" => "Κατηγορία συνεργασίας, στόχος παράδοσης και τιμές αγοράς.",
        "finances" => "Αξία παραγωγής, πληρωμές και αναλυτικές κινήσεις.",
        "production" => "Δηλωμένη παραγωγή και παραδόσεις.",
        "logistics" => "Δρομολόγια, ζυγίσεις και διακανονισμοί.",
        "invoices" => "Παραστατικά και εξοφλήσεις.",
        "documents" => "Σύμβαση και προσωπικός φάκελος.",
        "offers" => "Ενεργές προτάσεις και προμήθειες.",
        _ => "Η συνολική εικόνα της συνεργασίας σας."
    };
    ViewData["Title"] = isProfile ? "Προφίλ & ρυθμίσεις" : isMarketplace ? "Αγορά Δικτύου" : adminPage == "email" ? "Email & Newsletter" : User.IsInRole(RoleNames.Producer) ? pageTitle : "Portal";

    var mobileCrumb = isProfile ? "Προφίλ" : User.IsInRole(RoleNames.Producer) ? pageTitle : "Portal";
    var name = User.Identity?.Name ?? "";
    var hourNow = DateTime.Now.Hour;
    var greeting = (hourNow < 12) ? "Καλημέρα" : "Καλησπέρα";
    var atIdx = name.IndexOf((char)64);
    var fallbackDisplayName = (atIdx > 0) ? name.Substring(0, atIdx) : name;
    var displayName = Model switch
    {
        AccountProfileDto account => account.FullNameOrCompany,
        ProducerDashboardDto producerAccount => producerAccount.Profile.ProducerName,
        _ => ViewData["AccountDisplayName"] as string ?? fallbackDisplayName
    };
    var userInitial = string.IsNullOrEmpty(displayName) ? "?" : displayName.Substring(0, 1).ToUpperInvariant();
    var returnPath = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="portal-mobile-topbar">
    <button type="button" data-sidebar-toggle aria-label="Άνοιγμα πλευρικού μενού"><i class="fa-solid fa-bars"></i></button>
    <div class="crumb">
        <small>@role</small>
        <strong>@mobileCrumb</strong>
    </div>
</div>

<div class="dashboard-modal" id="marketplace-coming-soon" data-dashboard-modal hidden aria-hidden="true">
    <button class="dashboard-modal-backdrop" type="button" data-dashboard-modal-close aria-label="Κλείσιμο"></button>
    <section class="dashboard-modal-dialog dashboard-coming-soon" role="dialog" aria-modal="true" aria-labelledby="marketplace-coming-soon-title" tabindex="-1">
        <header class="dashboard-modal-head">
            <span class="dashboard-modal-icon"><i class="fa-solid fa-people-arrows"></i></span>
            <div>
                <small>ΝΕΑ ΥΠΗΡΕΣΙΑ ΔΙΚΤΥΟΥ</small>
                <h2 id="marketplace-coming-soon-title">Η Αγορά Δικτύου έρχεται σύντομα.</h2>
                <p>Η ιδιωτική εμπορική περιοχή προετοιμάζεται και δεν είναι ακόμη διαθέσιμη σε κανέναν λογαριασμό.</p>
            </div>
            <button class="dashboard-modal-close" type="button" data-dashboard-modal-close aria-label="Κλείσιμο"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <div class="coming-soon-body">
            <i class="fa-solid fa-shield-halved"></i>
            <p>Όταν ενεργοποιηθεί, θα είναι προσβάσιμη αποκλειστικά από επαληθευμένους συνεργάτες της AGRO UNION.</p>
            <button type="button" data-dashboard-modal-close>Κατάλαβα</button>
        </div>
    </section>
</div>
<div class="portal-sidebar-backdrop"></div>

<div class="dashboard-modal" id="participation-coming-soon" data-dashboard-modal hidden aria-hidden="true">
    <button class="dashboard-modal-backdrop" type="button" data-dashboard-modal-close aria-label="Κλείσιμο"></button>
    <section class="dashboard-modal-dialog dashboard-coming-soon" role="dialog" aria-modal="true" aria-labelledby="participation-coming-soon-title" tabindex="-1">
        <header class="dashboard-modal-head">
            <span class="dashboard-modal-icon"><i class="fa-solid fa-boxes-stacked"></i></span>
            <div>
                <small>ΣΥΛΛΟΓΙΚΕΣ ΠΡΟΜΗΘΕΙΕΣ</small>
                <h2 id="participation-coming-soon-title">Η ηλεκτρονική συμμετοχή δεν είναι ακόμη διαθέσιμη.</h2>
                <p>Η ποσότητα σε kg και η συμμετοχή σας θα ενεργοποιηθούν όταν ολοκληρωθεί η ασφαλής ροή επιβεβαίωσης παραγγελίας.</p>
            </div>
            <button class="dashboard-modal-close" type="button" data-dashboard-modal-close aria-label="Κλείσιμο"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <div class="coming-soon-body">
            <i class="fa-solid fa-lock"></i>
            <p>Μέχρι τότε δεν καταχωρίζεται καμία ποσότητα ή δέσμευση στον λογαριασμό σας.</p>
            <button type="button" data-dashboard-modal-close>Κατάλαβα</button>
        </div>
    </section>
</div>

<div class="portal-shell @((ViewData["CompactDashboard"] as bool? ?? false) ? "compact-dashboard" : "")">
    <aside class="portal-sidebar" aria-label="Πλοήγηση portal">
        <div class="portal-user">
            <span>@userInitial</span>
            <div>
                <strong>@displayName</strong>
                <small>@role</small>
            </div>
        </div>
        <nav class="portal-nav">
            @if (User.IsInRole(RoleNames.Producer))
            {
                <div class="portal-nav-section">Επισκόπηση</div>
                <a class="@(producerPage == "overview" ? "active" : "")" asp-action="ProducerPage" asp-route-page="overview"><i class="fa-solid fa-house"></i> Αρχική</a>
                <a class="@(producerPage == "collaboration" ? "active" : "")" asp-action="ProducerPage" asp-route-page="collaboration"><i class="fa-solid fa-medal"></i> Συνεργασία</a>
                <a class="@(producerPage == "finances" ? "active" : "")" asp-action="ProducerPage" asp-route-page="finances"><i class="fa-solid fa-chart-pie"></i> Οικονομικά</a>
                <div class="portal-nav-section">Δραστηριότητα</div>
                <a class="@(producerPage == "production" ? "active" : "")" asp-action="ProducerPage" asp-route-page="production"><i class="fa-solid fa-wheat-awn"></i> Παραγωγή</a>
                <a class="@(producerPage == "logistics" ? "active" : "")" asp-action="ProducerPage" asp-route-page="logistics"><i class="fa-solid fa-truck-fast"></i> Δρομολόγια</a>
                <a class="@(producerPage == "invoices" ? "active" : "")" asp-action="ProducerPage" asp-route-page="invoices"><i class="fa-solid fa-file-invoice-dollar"></i> Τιμολόγια</a>
                <a class="@(producerPage == "offers" ? "active" : "")" asp-action="ProducerPage" asp-route-page="offers"><i class="fa-solid fa-tag"></i> Προσφορές</a>
                @if(marketplaceEnabled){<a class="@(isMarketplace ? "active" : "")" asp-controller="Portal" asp-action="Marketplace"><i class="fa-solid fa-people-arrows"></i> Αγορά Δικτύου</a>}else{<button class="portal-nav-action" type="button" data-dashboard-modal-open="marketplace-coming-soon"><i class="fa-solid fa-people-arrows"></i> Αγορά Δικτύου <small>Σύντομα</small></button>}
                <a class="@(producerPage == "documents" ? "active" : "")" asp-action="ProducerPage" asp-route-page="documents"><i class="fa-solid fa-folder-open"></i> Έγγραφα</a>
            }
            else if (User.IsInRole(RoleNames.Admin))
            {
                <div class="portal-nav-section">Επισκόπηση</div>
                <a class="@(adminPage == "overview" ? "active" : "")" asp-controller="Portal" asp-action="Index"><i class="fa-solid fa-gauge-high"></i> Αρχική</a>
                <div class="portal-nav-section">Διαχείριση</div>
                <a asp-controller="Portal" asp-action="Index" asp-fragment="applications"><i class="fa-solid fa-user-plus"></i> Αιτήσεις</a>
                <a asp-controller="Portal" asp-action="Index" asp-fragment="users"><i class="fa-solid fa-users-gear"></i> Συνεργάτες</a>
                <a asp-controller="Portal" asp-action="Index" asp-fragment="producer-workspace"><i class="fa-solid fa-folder-open"></i> Φάκελος παραγωγού</a>
                <div class="portal-nav-section">Εμπορικά</div>
                @if(marketplaceEnabled){<a class="@(isMarketplace ? "active" : "")" asp-controller="Portal" asp-action="Marketplace"><i class="fa-solid fa-people-arrows"></i> Αγορά Δικτύου</a>}else{<button class="portal-nav-action" type="button" data-dashboard-modal-open="marketplace-coming-soon"><i class="fa-solid fa-people-arrows"></i> Αγορά Δικτύου <small>Σύντομα</small></button>}
                <a asp-controller="Portal" asp-action="Index" asp-fragment="deals"><i class="fa-solid fa-handshake"></i> Συμφωνίες</a>
                <a asp-controller="Portal" asp-action="Index" asp-fragment="messages"><i class="fa-solid fa-envelope"></i> Μηνύματα</a>
                <div class="portal-nav-section">Πλατφόρμα</div>
                <a asp-controller="Portal" asp-action="Index" asp-fragment="audit"><i class="fa-solid fa-shield-halved"></i> Audit log</a>
                <a asp-controller="Portal" asp-action="Index" asp-fragment="settings"><i class="fa-solid fa-sliders"></i> Ρυθμίσεις</a>
                <a class="@(adminPage == "email" ? "active" : "")" asp-controller="Portal" asp-action="EmailAdministration"><i class="fa-solid fa-paper-plane"></i> Email & Newsletter</a>
                <a asp-controller="Versions" asp-action="Index"><i class="fa-solid fa-box-archive"></i> Εκδόσεις</a>
            }
            else
            {
                <div class="portal-nav-section">Επισκόπηση</div>
                <a class="active" asp-controller="Portal" asp-action="Index"><i class="fa-solid fa-house"></i> Αρχική</a>
                <div class="portal-nav-section">Αγορές</div>
                @if(marketplaceEnabled){<a class="@(isMarketplace ? "active" : "")" asp-controller="Portal" asp-action="Marketplace"><i class="fa-solid fa-people-arrows"></i> Αγορά Δικτύου</a>}else{<button class="portal-nav-action" type="button" data-dashboard-modal-open="marketplace-coming-soon"><i class="fa-solid fa-people-arrows"></i> Αγορά Δικτύου <small>Σύντομα</small></button>}
                <a asp-controller="Portal" asp-action="Index" asp-fragment="offers"><i class="fa-solid fa-tag"></i> Προσφορές</a>
                <a asp-controller="Portal" asp-action="Index" asp-fragment="pickups"><i class="fa-solid fa-truck-fast"></i> Παραλαβές</a>
                <a asp-controller="Portal" asp-action="Index" asp-fragment="contracts"><i class="fa-solid fa-file-signature"></i> Σύμβαση</a>
                <div class="portal-nav-section">Πλατφόρμα</div>
                <a asp-controller="Versions" asp-action="Index"><i class="fa-solid fa-code-branch"></i> Εκδόσεις</a>
            }
        </nav>
        <div class="portal-sidebar-foot">
            <a class="@(isProfile ? "active" : "")" asp-controller="Portal" asp-action="Profile"><i class="fa-solid fa-user-gear"></i> Προφίλ</a>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
                <button class="portal-sidebar-logout" type="submit"><i class="fa-solid fa-arrow-right-from-bracket"></i> Αποσύνδεση</button>
            </form>
        </div>
    </aside>

    <section class="portal-content" style="padding:0 clamp(20px,3vw,56px) 96px">
        <div class="portal-toolbar">
            <span class="toolbar-date"><i class="fa-regular fa-calendar"></i> @DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
            <div class="toolbar-actions">
                <button class="toolbar-btn" type="button" data-dashboard-modal-open="dashboard-help-modal"><i class="fa-regular fa-circle-question"></i> Βοήθεια</button>
                <button class="toolbar-btn" type="button" data-dashboard-modal-open="dashboard-contact-modal"><i class="fa-regular fa-envelope"></i> Επικοινωνία</button>
                <a class="toolbar-user" asp-controller="Portal" asp-action="Profile">
                    <span class="av">@userInitial</span>
                    <span>@displayName<span class="role">· @role</span></span>
                </a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(maintenanceNotice))
        {
            <div class="portal-maintenance-notice"><i class="fa-solid fa-screwdriver-wrench"></i><div><strong>Ενημέρωση πλατφόρμας</strong><span>@maintenanceNotice</span></div></div>
        }

        <header class="exec-header" id="overview">
            <div class="exec-copy">
                <small>@(isProfile ? "Προσωπικός λογαριασμός" : isMarketplace ? "Ιδιωτικό δίκτυο συνεργατών" : adminPage == "email" ? "Κεντρική επικοινωνία" : User.IsInRole(RoleNames.Producer) ? "Λογαριασμός παραγωγού" : User.IsInRole(RoleNames.Admin) ? "Διαχείριση" : "Portal συνεργατών")</small>
                <h1>@(isProfile ? "Προφίλ & ρυθμίσεις" : isMarketplace ? "Αγορά Δικτύου" : adminPage == "email" ? "Email & Newsletter" : $"{greeting}, {displayName}.")</h1>
                <p>@(isProfile ? "Διαχειριστείτε τα προσωπικά στοιχεία, την ασφάλεια, τις προτιμήσεις και τα δεδομένα του λογαριασμού σας." : isMarketplace ? "Παραγωγή, ζήτηση και επαφές αποκλειστικά μεταξύ ενεργών συνεργατών της AGRO UNION." : adminPage == "email" ? "Ρυθμίσεις Brevo, συνδρομητές και ελεγχόμενες μαζικές αποστολές από ένα σημείο." : User.IsInRole(RoleNames.Producer) ? pageDescription : "Η συγκεντρωτική εικόνα του δικτύου σας.")</p>
            </div>
        </header>

        @if (Model is AccountProfileDto accountProfile)
        {
            @await Html.PartialAsync("_AccountProfile", accountProfile)
        }
        else if (Model is AdminDashboardDto admin)
        {
            @await Html.PartialAsync("_AdminDashboard", admin)
        }
        else if (Model is ProducerDashboardDto producer)
        {
            @await Html.PartialAsync("_ProducerDashboard", producer)
        }
        else if (Model is BuyerDashboardDto buyer)
        {
            @await Html.PartialAsync("_BuyerDashboard", buyer)
        }
        else if (Model is EmailAdministrationDto emailAdmin)
        {
            @await Html.PartialAsync("_EmailAdministration", emailAdmin)
        }
        else if (Model is PartnerMarketplaceDto partnerMarketplace)
        {
            @await Html.PartialAsync("_PartnerMarketplace", partnerMarketplace)
        }
    </section>
</div>

<div class="dashboard-modal" id="dashboard-help-modal" data-dashboard-modal hidden aria-hidden="true">
    <button class="dashboard-modal-backdrop" type="button" data-dashboard-modal-close aria-label="Κλείσιμο"></button>
    <section class="dashboard-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="dashboard-help-title" tabindex="-1">
        <header class="dashboard-modal-head">
            <span class="dashboard-modal-icon"><i class="fa-regular fa-circle-question"></i></span>
            <div>
                <small>ΥΠΟΣΤΗΡΙΞΗ ΣΥΝΕΡΓΑΤΩΝ</small>
                <h2 id="dashboard-help-title">Πώς μπορούμε να βοηθήσουμε;</h2>
                <p>Περιγράψτε το ζήτημα και η αρμόδια ομάδα θα αναλάβει το αίτημά σας.</p>
            </div>
            <button class="dashboard-modal-close" type="button" data-dashboard-modal-close aria-label="Κλείσιμο"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <form class="dashboard-support-form" asp-controller="Portal" asp-action="SubmitDashboardSupport" method="post">
            <input type="hidden" name="Kind" value="help" />
            <input type="hidden" name="ReturnPath" value="@returnPath" />
            <input class="hp" type="text" name="Website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <label>
                <span>Κατηγορία αιτήματος</span>
                <select name="Topic" required>
                    <option value="">Επιλέξτε κατηγορία</option>
                    <option>Πρόσβαση και λογαριασμός</option>
                    <option>Τεχνικό ζήτημα</option>
                    <option>Αγορά Δικτύου</option>
                    <option>Παραγωγή και παραδόσεις</option>
                    <option>Έγγραφα και πληρωμές</option>
                    <option>Άλλο θέμα</option>
                </select>
            </label>
            <label>
                <span>Περιγραφή</span>
                <textarea name="Message" rows="6" maxlength="2600" required placeholder="Δώστε μας τις απαραίτητες πληροφορίες για να σας εξυπηρετήσουμε σωστά."></textarea>
            </label>
            <div class="dashboard-modal-actions">
                <span><i class="fa-solid fa-shield-halved"></i> Το αίτημα καταγράφεται με ασφάλεια στον λογαριασμό σας.</span>
                <button type="submit">Αποστολή αιτήματος <i class="fa-solid fa-arrow-right"></i></button>
            </div>
        </form>
    </section>
</div>

<div class="dashboard-modal" id="dashboard-contact-modal" data-dashboard-modal hidden aria-hidden="true">
    <button class="dashboard-modal-backdrop" type="button" data-dashboard-modal-close aria-label="Κλείσιμο"></button>
    <section class="dashboard-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="dashboard-contact-title" tabindex="-1">
        <header class="dashboard-modal-head">
            <span class="dashboard-modal-icon"><i class="fa-regular fa-envelope"></i></span>
            <div>
                <small>ΑΜΕΣΗ ΕΠΙΚΟΙΝΩΝΙΑ</small>
                <h2 id="dashboard-contact-title">Επικοινωνήστε με την ομάδα μας</h2>
                <p>Το μήνυμα προωθείται εσωτερικά στην κατάλληλη ομάδα της AGRO UNION.</p>
            </div>
            <button class="dashboard-modal-close" type="button" data-dashboard-modal-close aria-label="Κλείσιμο"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <form class="dashboard-support-form" asp-controller="Portal" asp-action="SubmitDashboardSupport" method="post">
            <input type="hidden" name="Kind" value="contact" />
            <input type="hidden" name="ReturnPath" value="@returnPath" />
            <input class="hp" type="text" name="Website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="dashboard-form-grid">
                <label>
                    <span>Θέμα επικοινωνίας</span>
                    <select name="Topic" required>
                        <option value="">Επιλέξτε θέμα</option>
                        <option>Συνεργασία και σύμβαση</option>
                        <option>Οικονομικά και πληρωμές</option>
                        <option>Παραγωγή και παραλαβές</option>
                        <option>Προσφορές και αγορά</option>
                        <option>Γενική επικοινωνία</option>
                    </select>
                </label>
                <label>
                    <span>Τηλέφωνο επικοινωνίας <em>προαιρετικό</em></span>
                    <input type="tel" name="Phone" maxlength="30" inputmode="tel" placeholder="π.χ. 698 000 0000" />
                </label>
            </div>
            <label>
                <span>Μήνυμα</span>
                <textarea name="Message" rows="6" maxlength="2600" required placeholder="Γράψτε το μήνυμά σας προς την ομάδα μας."></textarea>
            </label>
            <div class="dashboard-modal-actions">
                <span><i class="fa-solid fa-lock"></i> Η ταυτότητά σας συνδέεται αυτόματα με το αίτημα.</span>
                <button type="submit">Αποστολή μηνύματος <i class="fa-solid fa-arrow-right"></i></button>
            </div>
        </form>
    </section>
</div>
