@model AgroUnion.Application.Contracts.AdminDashboardDto
@using AgroUnion.Domain.Entities
@{
    string DealStatusName(DealStatus s) => s switch
    {
        DealStatus.Proposed => "Προς επιβεβαίωση",
        DealStatus.BuySideConfirmed => "Επιβ. από παραγωγό",
        DealStatus.SellSideConfirmed => "Επιβ. από αγοραστή",
        DealStatus.Completed => "Ολοκληρώθηκε",
        DealStatus.Cancelled => "Ακυρώθηκε",
        _ => s.ToString()
    };
    string ContractStatusName(ContractStatus s) => s switch { ContractStatus.Draft => "Προσχέδιο", ContractStatus.Active => "Ενεργή", ContractStatus.Terminated => "Ολοκληρωμένη", _ => s.ToString() };
    string ApplicationStatusName(ApplicationStatus s) => s switch { ApplicationStatus.New => "Νέα", ApplicationStatus.InReview => "Σε αξιολόγηση", ApplicationStatus.Approved => "Εγκεκριμένη", ApplicationStatus.Rejected => "Απορρίφθηκε", _ => s.ToString() };
    string PartnerRoleName(PartnerRole r) => r switch { PartnerRole.Producer => "Παραγωγός", PartnerRole.Trader => "Έμπορος", PartnerRole.Company => "Επιχείρηση", _ => "Άλλο" };
    string UserRoleName(string r) => r switch { RoleNames.Admin => "Διαχειριστής", RoleNames.Producer => "Παραγωγός", RoleNames.Trader => "Έμπορος", RoleNames.Company => "Επιχείρηση", _ => r };

    var totalDealValue = Model.Deals.Sum(x => x.BuyPricePerUnit * x.Quantity);
    var completedDeals = Model.Deals.Count(x => x.Status == DealStatus.Completed);
    var pendingDeals = Model.Deals.Count(x => x.Status == DealStatus.Proposed);
    var unreadMessages = Model.Messages.Count(x => !x.IsRead);
    var draftContracts = Model.Contracts.Count(x => x.Status == ContractStatus.Draft);
    var newApps = Model.Applications.Count(x => x.Status == ApplicationStatus.New);
}

@* Alerts — only when items exist *@
@if (newApps > 0 || draftContracts > 0 || pendingDeals > 0 || unreadMessages > 0)
{
    <div class="alerts-strip">
        @if (newApps > 0)
        {
            <a class="alert-tile warning" href="#applications">
                <div class="at-ic"><i class="fa-solid fa-user-plus"></i></div>
                <div class="at-body"><div class="at-title">Νέες αιτήσεις</div><div class="at-desc">Χρειάζονται αξιολόγηση</div></div>
                <div class="at-count">@newApps</div>
            </a>
        }
        @if (draftContracts > 0)
        {
            <a class="alert-tile info" href="#contracts">
                <div class="at-ic"><i class="fa-solid fa-file-signature"></i></div>
                <div class="at-body"><div class="at-title">Προσχέδια συμβάσεων</div><div class="at-desc">Προς ενεργοποίηση</div></div>
                <div class="at-count">@draftContracts</div>
            </a>
        }
        @if (pendingDeals > 0)
        {
            <a class="alert-tile warning" href="#deals">
                <div class="at-ic"><i class="fa-solid fa-hourglass-half"></i></div>
                <div class="at-body"><div class="at-title">Deals σε εκκρεμότητα</div><div class="at-desc">Προς επιβεβαίωση</div></div>
                <div class="at-count">@pendingDeals</div>
            </a>
        }
        @if (unreadMessages > 0)
        {
            <a class="alert-tile danger" href="#messages">
                <div class="at-ic"><i class="fa-solid fa-envelope"></i></div>
                <div class="at-body"><div class="at-title">Αδιάβαστα μηνύματα</div><div class="at-desc">Επικοινωνία πελατών</div></div>
                <div class="at-count">@unreadMessages</div>
            </a>
        }
    </div>
}

@* 4 BIG KPIs *@
<div class="kpi-pro-grid">
    <article class="kpi-pro hero-card">
        <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-scale-balanced"></i></span><span>Συνολικό margin</span></div>
        <div class="kpi-pro-value">@Model.TotalMargin.ToString("N0") <span class="unit">€</span></div>
        <div class="kpi-pro-sub"><strong>@completedDeals</strong> ολοκληρωμένα deals</div>
    </article>

    <article class="kpi-pro">
        <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-users"></i></span><span>Ενεργοί συνεργάτες</span></div>
        <div class="kpi-pro-value">@Model.ActivePartners</div>
        <div class="kpi-pro-sub"><strong>@Model.Users.Count(x => x.Role == RoleNames.Producer)</strong> παραγωγοί</div>
    </article>

    <article class="kpi-pro">
        <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-user-plus"></i></span><span>Αιτήσεις</span></div>
        <div class="kpi-pro-value">@Model.Applications.Count</div>
        <div class="kpi-pro-sub"><strong>@Model.PendingApplications</strong> εκκρεμείς</div>
    </article>

    <article class="kpi-pro">
        <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-chart-column"></i></span><span>Διαθέσιμος όγκος</span></div>
        <div class="kpi-pro-value">@Model.AvailableVolume.ToString("N0") <span class="unit">kg</span></div>
        <div class="kpi-pro-sub"><strong>@Model.Production.Count</strong> δηλώσεις</div>
    </article>
</div>

@* Applications *@
<div class="section-title" id="applications">
    <h2>Αιτήσεις συνεργασίας</h2>
    <div class="rule"></div>
    @if (newApps > 0){<span class="pill-metric warning"><strong>@newApps</strong> νέες</span>}
</div>
<section class="admin-record-panel" data-record-browser data-page-size="8">
    <div class="record-filter-bar">
        <label class="record-search"><span>Αναζήτηση αιτήσεων</span><i class="fa-solid fa-magnifying-glass"></i><input data-record-search placeholder="Επωνυμία, email, προϊόν ή περιοχή" /></label>
        <label><span>Κατάσταση</span><select data-record-filter="status"><option value="all">Όλες</option><option value="new">Νέα</option><option value="inreview">Σε αξιολόγηση</option><option value="approved">Εγκεκριμένη</option><option value="rejected">Απορρίφθηκε</option></select></label>
        <label><span>Ρόλος</span><select data-record-filter="role"><option value="all">Όλοι</option><option value="producer">Παραγωγός</option><option value="trader">Έμπορος</option><option value="company">Επιχείρηση</option><option value="other">Άλλο</option></select></label>
        <strong class="record-count" data-record-count></strong>
    </div>
    <div class="table-wrap">
        <table class="data-table pro admin-application-table">
            <thead><tr><th>Αιτών</th><th>Ρόλος</th><th>Περιοχή</th><th>Επικοινωνία</th><th>Κατάσταση</th><th>Ενέργειες</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Applications.OrderByDescending(x => x.CreatedAt))
                {
                    var statusKey = item.Status.ToString().ToLowerInvariant();
                    var roleKey = item.Role.ToString().ToLowerInvariant();
                    <tr data-record-row data-search="@(item.FullNameOrCompany.ToLowerInvariant()) @(item.Email.ToLowerInvariant()) @(item.ProductInterest.ToLowerInvariant()) @(item.Region.ToLowerInvariant())" data-status="@statusKey" data-role="@roleKey" data-detail-modal="application-detail-modal" data-detail-id="@item.Id" data-detail-name="@item.FullNameOrCompany" data-detail-role="@PartnerRoleName(item.Role)" data-detail-region="@item.Region" data-detail-contact="@item.Email · @item.Phone" data-detail-product="@item.ProductInterest" data-detail-message="@item.Message" data-detail-notes="@item.InternalNotes" data-detail-status="@ApplicationStatusName(item.Status)" data-detail-status-value="@item.Status" data-detail-created="@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")" tabindex="0">
                        <td><strong>@item.FullNameOrCompany</strong><small>@item.ProductInterest · @item.CreatedAt.ToString("dd/MM/yyyy")</small></td>
                        <td>@PartnerRoleName(item.Role)</td>
                        <td>@item.Region</td>
                        <td><small>@item.Email<br />@item.Phone</small></td>
                        <td><span class="status-pill @statusKey">@ApplicationStatusName(item.Status)</span></td>
                        <td>
                            <div class="admin-inline-actions">
                                <button class="btn btn-sm btn-ghost" type="button" data-record-open><i class="fa-regular fa-eye"></i></button>
                                @if (item.Status != ApplicationStatus.Approved && item.Role != PartnerRole.Other)
                                {
                                    <form asp-action="ApproveApplication" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-brass" data-confirm="Έγκριση και δημιουργία λογαριασμού;"><i class="fa-solid fa-check"></i> Έγκριση</button></form>
                                }
                                @if (item.Status is ApplicationStatus.New or ApplicationStatus.InReview)
                                {
                                    @if(item.Status == ApplicationStatus.New){<form asp-action="UpdateApplication" method="post"><input type="hidden" name="Id" value="@item.Id" /><input type="hidden" name="Status" value="InReview" /><button class="btn btn-sm btn-ghost" title="Σε αξιολόγηση"><i class="fa-solid fa-hourglass-half"></i></button></form>}
                                    <form asp-action="UpdateApplication" method="post"><input type="hidden" name="Id" value="@item.Id" /><input type="hidden" name="Status" value="Rejected" /><button class="btn btn-sm btn-danger-soft" data-confirm="Να απορριφθεί η αίτηση;"><i class="fa-solid fa-xmark"></i></button></form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="admin-filter-empty" data-record-empty hidden><i class="fa-solid fa-filter-circle-xmark"></i> Δεν βρέθηκαν αιτήσεις με αυτά τα φίλτρα.</div>
    <div class="record-pagination"><button type="button" data-record-prev><i class="fa-solid fa-chevron-left"></i></button><span data-record-page></span><button type="button" data-record-next><i class="fa-solid fa-chevron-right"></i></button></div>
</section>

<div class="dashboard-modal" id="application-detail-modal" data-dashboard-modal hidden aria-hidden="true">
    <button class="dashboard-modal-backdrop" type="button" data-dashboard-modal-close aria-label="Κλείσιμο"></button>
    <section class="dashboard-modal-dialog admin-detail-dialog" role="dialog" aria-modal="true" tabindex="-1">
        <header class="dashboard-modal-head"><span class="dashboard-modal-icon"><i class="fa-solid fa-user-check"></i></span><div><small>ΦΑΚΕΛΟΣ ΑΙΤΗΣΗΣ</small><h2 data-record-field="name"></h2><p>Πλήρης αξιολόγηση πριν τη δημιουργία λογαριασμού.</p></div><button class="dashboard-modal-close" type="button" data-dashboard-modal-close><i class="fa-solid fa-xmark"></i></button></header>
        <div class="admin-detail-grid"><div><small>Ρόλος</small><strong data-record-field="role"></strong></div><div><small>Κατάσταση</small><strong data-record-field="status"></strong></div><div><small>Περιοχή</small><strong data-record-field="region"></strong></div><div><small>Επικοινωνία</small><strong data-record-field="contact"></strong></div><div><small>Προϊόν / αντικείμενο</small><strong data-record-field="product"></strong></div><div><small>Υποβλήθηκε</small><strong data-record-field="created"></strong></div><div class="wide"><small>Μήνυμα αιτούντος</small><p data-record-field="message"></p></div></div>
        <form class="dashboard-support-form application-review-form" asp-action="UpdateApplication" method="post"><input type="hidden" name="Id" data-record-value="id" /><label><span>Κατάσταση αξιολόγησης</span><select name="Status" data-record-value="statusValue"><option value="New">Νέα</option><option value="InReview">Σε αξιολόγηση</option><option value="Rejected">Απόρριψη</option></select></label><label><span>Εσωτερικές σημειώσεις</span><textarea name="Notes" rows="4" maxlength="3000" data-record-value="notes"></textarea></label><div class="dashboard-modal-actions"><span><i class="fa-solid fa-lock"></i> Οι σημειώσεις είναι ορατές μόνο στη διαχείριση.</span><button type="submit">Αποθήκευση αξιολόγησης</button></div></form>
    </section>
</div>

@* Producer workspace *@
@await Html.PartialAsync("_AdminProducerWorkspace", Model.ProducerWorkspace)

@* All deals *@
<div class="section-title" id="deals">
    <h2>Όλες οι συμφωνίες</h2>
    <div class="rule"></div>
    <a class="more" asp-action="MarginCsv"><i class="fa-solid fa-file-csv"></i> CSV margin</a>
</div>
<div class="pill-row">
    <span class="pill-metric"><i class="fa-solid fa-handshake"></i> <strong>@Model.Deals.Count</strong> σύνολο</span>
    <span class="pill-metric success"><i class="fa-solid fa-check"></i> <strong>@completedDeals</strong> ολοκληρωμένα</span>
    @if (pendingDeals > 0){<span class="pill-metric warning"><i class="fa-solid fa-hourglass"></i> <strong>@pendingDeals</strong> εκκρεμή</span>}
    <span class="pill-metric"><i class="fa-solid fa-scale-balanced"></i> Margin <strong>@Model.TotalMargin.ToString("N2") €</strong></span>
</div>
<div class="table-wrap">
    <table class="data-table pro">
        <thead>
            <tr>
                <th>Ημερομηνία</th>
                <th>Προϊόν</th>
                <th>Τύπος</th>
                <th class="right">Αγορά</th>
                <th class="right">Πώληση</th>
                <th class="right">Ποσότητα</th>
                <th class="right">Margin</th>
                <th>Κατάσταση</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Deals.OrderByDescending(x => x.CreatedAt))
            {
                <tr>
                    <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td><strong>@item.Product</strong></td>
                    <td><small style="color:var(--ink-500)">@item.DealType</small></td>
                    <td class="right num sensitive">@item.BuyPricePerUnit.ToString("N2") €</td>
                    <td class="right num sensitive">@item.SellPricePerUnit.ToString("N2") €</td>
                    <td class="right num">@item.Quantity.ToString("N0")</td>
                    <td class="right num pos">@item.TotalMargin.ToString("N2") €</td>
                    <td><span class="status-pill @(item.Status == DealStatus.Proposed ? "proposed" : item.Status.ToString().ToLowerInvariant())">@DealStatusName(item.Status)</span></td>
                </tr>
            }
            @if (Model.Deals.Count == 0)
            {
                <tr><td colspan="8"><div class="portal-empty compact"><i class="fa-solid fa-handshake"></i><span>Καμία συμφωνία.</span></div></td></tr>
            }
        </tbody>
    </table>
</div>

@* New deal form *@
<details class="disclosure" style="margin-top:16px" id="deals-new">
    <summary><i class="fa-solid fa-plus"></i> Νέα συμφωνία (δύο σκέλη)</summary>
    <div class="privacy-note" style="margin:0 20px 12px 20px"><i class="fa-solid fa-eye"></i><span>Μόνο διαχειριστές βλέπουν αγορά + πώληση + margin μαζί.</span></div>
    <form class="workspace-form" asp-action="CreateDeal" method="post">
        <div class="field"><label>Τύπος</label><select name="DealType"><option value="Brokerage">Brokerage</option><option value="Facilitation">Facilitation</option></select></div>
        <div class="field"><label>Δήλωση (GUID)</label><input name="ProductionDeclarationId" placeholder="προαιρετικό" /></div>
        <div class="field"><label>Παραγωγός</label><select name="FarmerUserId">@foreach (var u in Model.Users.Where(x => x.Role == RoleNames.Producer)){<option value="@u.Id">@u.Name</option>}</select></div>
        <div class="field"><label>Αγοραστής</label><select name="BuyerUserId">@foreach (var u in Model.Users.Where(x => x.Role == RoleNames.Trader || x.Role == RoleNames.Company)){<option value="@u.Id">@u.Name</option>}</select></div>
        <div class="field"><label>Τιμή αγοράς</label><input name="BuyPricePerUnit" type="number" step="0.0001" /></div>
        <div class="field"><label>Ποσότητα αγοράς</label><input name="BuyQuantity" type="number" step="0.001" /></div>
        <div class="field"><label>Τιμή πώλησης</label><input name="SellPricePerUnit" type="number" step="0.0001" /></div>
        <div class="field"><label>Ποσότητα πώλησης</label><input name="SellQuantity" type="number" step="0.001" /></div>
        <button class="workspace-save" type="submit"><i class="fa-solid fa-plus"></i> Δημιουργία συμφωνίας</button>
    </form>
</details>

@* Users *@
<div class="section-title" id="users">
    <h2>Χρήστες, ρόλοι & πρόσβαση</h2>
    <div class="rule"></div>
    <span class="pill-metric"><strong>@Model.AdminUsers.Count</strong> λογαριασμοί</span>
</div>
<section class="admin-record-panel" data-record-browser data-page-size="8">
    <div class="record-filter-bar">
        <label class="record-search"><span>Αναζήτηση χρηστών</span><i class="fa-solid fa-magnifying-glass"></i><input data-record-search placeholder="Όνομα, email, κωδικός μέλους ή περιοχή" /></label>
        <label><span>Ρόλος</span><select data-record-filter="role"><option value="all">Όλοι</option><option value="admin">Admin</option><option value="producer">Παραγωγοί</option><option value="trader">Έμποροι</option><option value="company">Επιχειρήσεις</option></select></label>
        <label><span>Κατάσταση</span><select data-record-filter="status"><option value="all">Όλες</option><option value="active">Ενεργοί</option><option value="paused">Σε παύση</option></select></label>
        <label><span>Κατηγορία</span><select data-record-filter="category"><option value="all">Όλες</option><option value="strategic">Α</option><option value="premium">Β</option><option value="advanced">Γ</option><option value="standard">Δ</option><option value="developing">Ε</option><option value="none">Χωρίς κατηγορία</option></select></label>
        <strong class="record-count" data-record-count></strong>
    </div>
    <div class="table-wrap">
        <table class="data-table pro admin-users-table">
            <thead><tr><th>Λογαριασμός</th><th>Ρόλος / κατηγορία</th><th>Περιοχή</th><th>Τελευταία σύνδεση</th><th>Κατάσταση</th><th>Διαχείριση</th></tr></thead>
            <tbody>
                @foreach (var user in Model.AdminUsers.OrderBy(x => x.Name))
                {
                    var categoryKey = user.Category?.ToString().ToLowerInvariant() ?? "none";
                    var categoryName = user.Category switch { ProducerCategory.Strategic => "Κατηγορία Α", ProducerCategory.Premium => "Κατηγορία Β", ProducerCategory.Advanced => "Κατηγορία Γ", ProducerCategory.Standard => "Κατηγορία Δ", ProducerCategory.Developing => "Κατηγορία Ε", _ => "—" };
                    <tr data-record-row data-search="@(user.Name.ToLowerInvariant()) @(user.Email.ToLowerInvariant()) @(user.Region.ToLowerInvariant()) @(user.MembershipCode?.ToLowerInvariant())" data-role="@user.Role.ToLowerInvariant()" data-status="@(user.IsActive ? "active" : "paused")" data-category="@categoryKey">
                        <td><div class="cell-avatar"><div class="av">@(string.IsNullOrEmpty(user.Name) ? "?" : user.Name[..1].ToUpperInvariant())</div><div class="info"><strong>@user.Name</strong><small>@user.Email</small><small>@(user.MembershipCode ?? "Χωρίς κωδικό μέλους")</small></div></div></td>
                        <td><strong>@UserRoleName(user.Role)</strong><small>@categoryName</small></td>
                        <td>@user.Region</td>
                        <td>@(user.LastLoginAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Δεν έχει συνδεθεί")</td>
                        <td><span class="status-pill @(user.IsActive ? "active" : "closed")">@(user.IsActive ? "Ενεργός" : "Σε παύση")</span><small>@(user.EmailConfirmed ? "Email επιβεβαιωμένο" : "Email μη επιβεβαιωμένο")</small></td>
                        <td><button class="btn btn-sm btn-ghost" type="button" data-dashboard-modal-open="admin-user-@user.Id"><i class="fa-solid fa-user-gear"></i> Διαχείριση</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="admin-filter-empty" data-record-empty hidden><i class="fa-solid fa-users-slash"></i> Δεν βρέθηκαν λογαριασμοί με αυτά τα φίλτρα.</div>
    <div class="record-pagination"><button type="button" data-record-prev><i class="fa-solid fa-chevron-left"></i></button><span data-record-page></span><button type="button" data-record-next><i class="fa-solid fa-chevron-right"></i></button></div>
</section>

@foreach (var user in Model.AdminUsers)
{
    var isAdminAccount = user.Role == RoleNames.Admin;
    <div class="dashboard-modal" id="admin-user-@user.Id" data-dashboard-modal hidden aria-hidden="true">
        <button class="dashboard-modal-backdrop" type="button" data-dashboard-modal-close aria-label="Κλείσιμο"></button>
        <section class="dashboard-modal-dialog admin-user-dialog" role="dialog" aria-modal="true" tabindex="-1">
            <header class="dashboard-modal-head"><span class="dashboard-modal-icon"><i class="fa-solid fa-user-gear"></i></span><div><small>ΔΙΑΧΕΙΡΙΣΗ ΛΟΓΑΡΙΑΣΜΟΥ</small><h2>@user.Name</h2><p>@user.Email · δημιουργήθηκε @user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</p></div><button class="dashboard-modal-close" type="button" data-dashboard-modal-close><i class="fa-solid fa-xmark"></i></button></header>
            <form class="admin-user-form" asp-action="UpdateAdminUser" method="post">
                <input type="hidden" name="UserId" value="@user.Id" />
                <div class="admin-user-stats"><span><strong>@user.ProductionDeclarations</strong> δηλώσεις</span><span><strong>@user.ActiveContracts</strong> ενεργές συμβάσεις</span><span><strong>@user.Documents</strong> έγγραφα</span><span><strong>@user.Invoices</strong> παραστατικά</span><span><strong>@user.AuditEvents</strong> audit events</span></div>
                <div class="workspace-form admin-user-grid">
                    <div class="field"><label>Ονοματεπώνυμο / επωνυμία</label><input name="FullNameOrCompany" value="@user.Name" required /></div>
                    <div class="field"><label>Email σύνδεσης</label><input name="Email" type="email" value="@user.Email" required /></div>
                    <div class="field"><label>Τηλέφωνο</label><input name="PhoneNumber" value="@user.PhoneNumber" /></div>
                    <div class="field"><label>Περιοχή</label><input name="Region" value="@user.Region" required /></div>
                    <div class="field"><label>Κωδικός μέλους</label><input name="MembershipCode" value="@user.MembershipCode" placeholder="π.χ. AU-P-0101" /></div>
                    <div class="field"><label>Ρόλος πρόσβασης</label>@if(isAdminAccount){<input type="hidden" name="Role" value="Admin" /><input value="Admin" disabled />}else{<select name="Role"><option value="Producer" selected="@(user.Role==RoleNames.Producer)">Παραγωγός</option><option value="Trader" selected="@(user.Role==RoleNames.Trader)">Έμπορος</option><option value="Company" selected="@(user.Role==RoleNames.Company)">Επιχείρηση</option></select>}</div>
                    <div class="field"><label>Κατηγορία παραγωγού</label><select name="Category"><option value="">Χωρίς κατηγορία</option><option value="Strategic" selected="@(user.Category==ProducerCategory.Strategic)">Α · 50 τόνοι και πάνω</option><option value="Premium" selected="@(user.Category==ProducerCategory.Premium)">Β · 20–49,99 τόνοι</option><option value="Advanced" selected="@(user.Category==ProducerCategory.Advanced)">Γ · 10–19,99 τόνοι</option><option value="Standard" selected="@(user.Category==ProducerCategory.Standard)">Δ · 3–9,99 τόνοι</option><option value="Developing" selected="@(user.Category==ProducerCategory.Developing)">Ε · 0–2,99 τόνοι</option></select></div>
                    <div class="field toggle-field">@if(isAdminAccount){<label><input type="checkbox" checked disabled /> Ενεργός λογαριασμός</label><input type="hidden" name="IsActive" value="true" />}else{<label><input type="checkbox" name="IsActive" value="true" checked="@(user.IsActive ? "checked" : null)" /> Ενεργός λογαριασμός</label><input type="hidden" name="IsActive" value="false" />}</div>
                    <div class="field toggle-field"><label><input type="checkbox" name="EmailConfirmed" value="true" checked="@(user.EmailConfirmed ? "checked" : null)" /> Επιβεβαιωμένο email</label><input type="hidden" name="EmailConfirmed" value="false" /></div>
                    <div class="field full"><label>Εσωτερικές σημειώσεις διαχείρισης</label><textarea name="AdminNotes" rows="4" maxlength="3000">@user.AdminNotes</textarea><small>Δεν εμφανίζονται στον συνεργάτη.</small></div>
                    <button class="workspace-save" type="submit"><i class="fa-solid fa-floppy-disk"></i> Αποθήκευση πλήρους φακέλου</button>
                </div>
            </form>
            @if (!isAdminAccount)
            {
                <div class="admin-danger-zone">
                    <div><strong>Ενέργειες πρόσβασης</strong><small>Οι ενέργειες καταγράφονται στο audit log.</small></div>
                    <form asp-action="SetUserActive" method="post"><input type="hidden" name="UserId" value="@user.Id" /><input type="hidden" name="Active" value="@(!user.IsActive)" /><button class="btn btn-sm btn-ghost" data-confirm="@(user.IsActive ? "Να τεθεί ο λογαριασμός σε παύση;" : "Να ενεργοποιηθεί ξανά ο λογαριασμός;")"><i class="fa-solid @(user.IsActive ? "fa-pause" : "fa-play")"></i> @(user.IsActive ? "Παύση" : "Ενεργοποίηση")</button></form>
                    <form asp-action="ResetPassword" asp-route-userId="@user.Id" method="post"><button class="btn btn-sm btn-ghost" data-confirm="Να εκδοθεί νέος προσωρινός κωδικός;"><i class="fa-solid fa-key"></i> Reset κωδικού</button></form>
                    <form asp-action="DeletePersonalData" asp-route-userId="@user.Id" method="post"><button class="btn btn-sm btn-danger-soft" data-confirm="Οριστική ανωνυμοποίηση προσωπικών δεδομένων; Η ενέργεια δεν αναιρείται."><i class="fa-solid fa-user-slash"></i> Ανωνυμοποίηση</button></form>
                </div>
            }
        </section>
    </div>
}

@* Contracts *@
<div class="section-title" id="contracts">
    <h2>Συμβάσεις</h2>
    <div class="rule"></div>
</div>
<div class="table-wrap">
    <table class="data-table pro">
        <thead><tr><th>Αριθμός</th><th>Συνεργάτης</th><th>Κατάσταση</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in Model.Contracts)
            {
                <tr>
                    <td><strong>@c.ContractNumber</strong></td>
                    <td>@c.Partner</td>
                    <td><span class="status-pill @(c.Status == ContractStatus.Draft ? "proposed" : c.Status.ToString().ToLowerInvariant())">@ContractStatusName(c.Status)</span></td>
                    <td>@if (c.Status == ContractStatus.Draft){<form asp-action="ActivateContract" asp-route-id="@c.Id" method="post" style="margin:0"><button class="btn btn-sm btn-brass"><i class="fa-solid fa-play"></i> Ενεργοποίηση</button></form>}</td>
                </tr>
            }
            @if (Model.Contracts.Count == 0)
            {
                <tr><td colspan="4"><div class="portal-empty compact"><i class="fa-solid fa-file-signature"></i><span>Καμία σύμβαση.</span></div></td></tr>
            }
        </tbody>
    </table>
</div>

@* Prices *@
<div class="section-title">
    <h2>Τιμοκατάλογος</h2>
    <div class="rule"></div>
</div>
<div class="admin-price-guidance">
    <i class="fa-solid fa-circle-info"></i>
    <div><strong>Τιμές ανά προϊόν και εμπορική διαλογή</strong><span>Καταχωρίστε την ακριβή ποιότητα, μέγεθος ή κατηγορία. Ο παραγωγός βλέπει μόνο την τιμή που λαμβάνει.</span></div>
</div>
<div class="table-wrap">
    <table class="data-table pro">
        <thead><tr><th>Προϊόν · ποιότητα / μέγεθος</th><th>Τύπος</th><th>Περίοδος ισχύος</th><th class="right">Τιμή παραγωγού</th><th></th></tr></thead>
        <tbody>
            @foreach (var pr in Model.PriceList)
            {
                <tr>
                    <td><strong>@pr.ProductName</strong></td>
                    <td><span class="status-pill">@(pr.Category == PriceCategory.Product ? "Προϊόν" : "Εφόδιο")</span></td>
                    <td>@pr.EffectiveFrom.ToString("dd/MM/yyyy")@(pr.EffectiveTo.HasValue ? $" – {pr.EffectiveTo.Value:dd/MM/yyyy}" : " και μετά")</td>
                    <td class="right num">@pr.Price.ToString("N2") € / @pr.Unit</td>
                    <td><form asp-action="DeletePrice" asp-route-id="@pr.Id" method="post" style="margin:0"><button class="icon-delete" data-confirm="Διαγραφή;"><i class="fa-solid fa-trash"></i></button></form></td>
                </tr>
            }
            @if (Model.PriceList.Count == 0)
            {
                <tr><td colspan="5"><div class="portal-empty compact"><i class="fa-solid fa-tags"></i><span>Καμία δημοσιευμένη τιμή.</span></div></td></tr>
            }
        </tbody>
    </table>
</div>
<details class="disclosure" style="margin-top:16px">
    <summary><i class="fa-solid fa-plus"></i> Νέα τιμή</summary>
    <form class="workspace-form" asp-action="CreatePrice" method="post">
        <div class="field"><label>Κατηγορία</label><select name="Category"><option value="Product">Προϊόν</option><option value="Supply">Εφόδιο</option></select></div>
        <div class="field"><label>Προϊόν · ποιότητα / μέγεθος</label><input name="ProductName" list="producer-price-products" placeholder="π.χ. Ελιά Καλαμών · 181–200 τεμ./kg" required /></div>
        <datalist id="producer-price-products">
            <option value="Ελαιόλαδο · Έξτρα παρθένο ≤0,8%"></option>
            <option value="Ελαιόλαδο · Παρθένο 0,8–2,0%"></option>
            <option value="Ελιά Καλαμών · 121–140 τεμ./kg"></option>
            <option value="Ελιά Καλαμών · 141–160 τεμ./kg"></option>
            <option value="Ελιά Καλαμών · 161–180 τεμ./kg"></option>
            <option value="Ελιά Καλαμών · 181–200 τεμ./kg"></option>
            <option value="Ελιά Καλαμών · 201–230 τεμ./kg"></option>
            <option value="Πορτοκάλια · Κατηγορία Α"></option>
            <option value="Μανταρίνια · Κατηγορία Α"></option>
            <option value="Λεμόνια · Κατηγορία Α"></option>
        </datalist>
        <div class="field"><label>Τιμή που λαμβάνει ο παραγωγός</label><input name="Price" type="number" step=".0001" required /></div>
        <div class="field"><label>Μονάδα</label><input name="Unit" value="kg" /></div>
        <div class="field"><label>Από</label><input name="EffectiveFrom" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
        <div class="field"><label>Έως (προαιρετικά)</label><input name="EffectiveTo" type="date" /></div>
        <div class="field"><label>Ορατό σε</label><input name="VisibleToRoles" value="Producer,Trader,Company" /></div>
        <button class="workspace-save"><i class="fa-solid fa-upload"></i> Δημοσίευση</button>
    </form>
</details>

@* Messages *@
<div class="section-title" id="messages">
    <h2>Μηνύματα από επισκέπτες</h2>
    <div class="rule"></div>
    @if (unreadMessages > 0){<span class="pill-metric danger"><strong>@unreadMessages</strong> αδιάβαστα</span>}
</div>
<div class="table-wrap">
    <table class="data-table pro">
        <thead><tr><th>Ημερομηνία</th><th>Αποστολέας</th><th>Μήνυμα</th><th></th></tr></thead>
        <tbody>
            @foreach (var m in Model.Messages.OrderByDescending(x => x.CreatedAt))
            {
                <tr style="@(!m.IsRead ? "background:var(--warning-bg)" : "")">
                    <td>@m.CreatedAt.ToString("dd/MM/yy · HH:mm")</td>
                    <td><strong>@m.FullName</strong><br /><small style="color:var(--ink-500)">@m.Email</small></td>
                    <td style="font-size:14px">@m.Message</td>
                    <td>@if (!m.IsRead){<form asp-action="MarkContactRead" asp-route-id="@m.Id" method="post" style="margin:0"><button class="btn btn-sm"><i class="fa-solid fa-check"></i> Ανάγνωση</button></form>}else{<span class="status-pill">Αναγνωσμένο</span>}</td>
                </tr>
            }
            @if (Model.Messages.Count == 0)
            {
                <tr><td colspan="4"><div class="portal-empty compact"><i class="fa-solid fa-envelope-open"></i><span>Καμία επικοινωνία.</span></div></td></tr>
            }
        </tbody>
    </table>
</div>

@* Advanced platform settings *@
<div class="section-title" id="settings">
    <h2>Προηγμένες ρυθμίσεις πλατφόρμας</h2>
    <div class="rule"></div>
    <span class="pill-metric"><i class="fa-solid fa-shield-halved"></i> Admin only</span>
</div>
<section class="platform-settings-card">
    <header><div><small>ΚΕΝΤΡΙΚΗ ΠΟΛΙΤΙΚΗ ΛΕΙΤΟΥΡΓΙΑΣ</small><h3>Έλεγχος πρόσβασης, αιτήσεων και προεπιλογών</h3><p>Οι αλλαγές εφαρμόζονται σε επίπεδο πλατφόρμας και καταγράφονται αυτόματα στο audit log.</p></div><span>Τελευταία ενημέρωση<br /><strong>@Model.PlatformConfiguration.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong><br />@Model.PlatformConfiguration.UpdatedBy</span></header>
    <form asp-action="SavePlatformConfiguration" method="post" class="platform-settings-form">
        <div class="maintenance-toggle-card @(Model.PlatformConfiguration.MaintenanceMode ? "is-active" : "")">
            <div class="maintenance-toggle-head">
                <span class="maintenance-toggle-ic"><i class="fa-solid fa-screwdriver-wrench"></i></span>
                <div>
                    <strong>Λειτουργία υπό συντήρηση</strong>
                    <small>Όταν είναι ενεργή, όλες οι σελίδες του ιστότοπου (πλην των admin σελίδων &amp; login) αντικαθίστανται από πλήρη σελίδα «Υπό ανάπτυξη». Οι διαχειριστές διατηρούν πρόσβαση σε όλα.</small>
                </div>
                <label class="maintenance-switch">
                    <input type="checkbox" name="MaintenanceMode" value="true" checked="@(Model.PlatformConfiguration.MaintenanceMode ? "checked" : null)" />
                    <input type="hidden" name="MaintenanceMode" value="false" />
                    <span class="track"><span class="thumb"></span></span>
                </label>
            </div>
            <div class="maintenance-toggle-fields">
                <div class="field"><label>Τίτλος σελίδας συντήρησης</label><input name="MaintenanceTitle" value="@Model.PlatformConfiguration.MaintenanceTitle" maxlength="180" placeholder="Ο ιστότοπος βρίσκεται υπό αναβάθμιση" /></div>
                <div class="field full"><label>Μήνυμα για επισκέπτες</label><textarea name="MaintenanceMessage" rows="3" maxlength="1000" placeholder="Θα επιστρέψουμε πολύ σύντομα.">@Model.PlatformConfiguration.MaintenanceMessage</textarea></div>
            </div>
        </div>
        <div class="settings-switch-grid">
            <label class="settings-switch"><span><strong>Νέες αιτήσεις συνεργασίας</strong><small>Αποδοχή νέων αιτήσεων από τις δημόσιες φόρμες.</small></span><input type="checkbox" name="AcceptingApplications" value="true" checked="@(Model.PlatformConfiguration.AcceptingApplications ? "checked" : null)" /><input type="hidden" name="AcceptingApplications" value="false" /><i></i></label>
            <label class="settings-switch"><span><strong>Επεξεργασία προφίλ</strong><small>Οι συνεργάτες μπορούν να αλλάζουν τα προσωπικά στοιχεία τους.</small></span><input type="checkbox" name="AllowProfileEditing" value="true" checked="@(Model.PlatformConfiguration.AllowProfileEditing ? "checked" : null)" /><input type="hidden" name="AllowProfileEditing" value="false" /><i></i></label>
            <label class="settings-switch"><span><strong>Επιβεβαιωμένο email</strong><small>Απαίτηση επιβεβαιωμένου email για είσοδο στο portal.</small></span><input type="checkbox" name="RequireConfirmedEmail" value="true" checked="@(Model.PlatformConfiguration.RequireConfirmedEmail ? "checked" : null)" /><input type="hidden" name="RequireConfirmedEmail" value="false" /><i></i></label>
            <label class="settings-switch"><span><strong>Ειδοποιήσεις email</strong><small>Κεντρικός διακόπτης λειτουργικών email.</small></span><input type="checkbox" name="EmailNotificationsEnabled" value="true" checked="@(Model.PlatformConfiguration.EmailNotificationsEnabled ? "checked" : null)" /><input type="hidden" name="EmailNotificationsEnabled" value="false" /><i></i></label>
            <label class="settings-switch"><span><strong>Αγορά Δικτύου</strong><small>Feature flag. Παραμένει κλειστή μέχρι την επίσημη ενεργοποίηση.</small></span><input type="checkbox" name="MarketplaceEnabled" value="true" checked="@(Model.PlatformConfiguration.MarketplaceEnabled ? "checked" : null)" /><input type="hidden" name="MarketplaceEnabled" value="false" /><i></i></label>
        </div>
        <div class="workspace-form platform-settings-fields">
            <div class="field"><label>Email υποστήριξης</label><input name="SupportEmail" type="email" value="@Model.PlatformConfiguration.SupportEmail" required /></div>
            <div class="field"><label>Τηλέφωνο υποστήριξης</label><input name="SupportPhone" value="@Model.PlatformConfiguration.SupportPhone" required /></div>
            <div class="field"><label>Προεπιλεγμένος υπεύθυνος λογαριασμού</label><input name="DefaultAccountManager" value="@Model.PlatformConfiguration.DefaultAccountManager" required /></div>
            <div class="field"><label>Διατήρηση audit log (ημέρες)</label><input name="AuditRetentionDays" type="number" min="30" max="3650" value="@Model.PlatformConfiguration.AuditRetentionDays" required /></div>
            <div class="field full"><label>Προεπιλεγμένοι όροι πληρωμής νέων παραγωγών</label><textarea name="DefaultPaymentTerms" rows="3" required>@Model.PlatformConfiguration.DefaultPaymentTerms</textarea></div>
            <div class="field full"><label>Μήνυμα όταν οι αιτήσεις είναι σε παύση</label><textarea name="ApplicationPauseMessage" rows="2" required>@Model.PlatformConfiguration.ApplicationPauseMessage</textarea></div>
            <div class="field full"><label>Εσωτερική ανακοίνωση συντήρησης</label><textarea name="MaintenanceNotice" rows="2" placeholder="Προαιρετικό μήνυμα προς τους χρήστες του portal">@Model.PlatformConfiguration.MaintenanceNotice</textarea></div>
            <button class="workspace-save" type="submit"><i class="fa-solid fa-floppy-disk"></i> Αποθήκευση ρυθμίσεων</button>
        </div>
    </form>
</section>

@* Full audit log *@
<div class="section-title" id="audit">
    <h2>Audit log πλατφόρμας</h2>
    <div class="rule"></div>
    <a class="more" asp-action="AuditCsv"><i class="fa-solid fa-file-csv"></i> Εξαγωγή CSV</a>
</div>
<section class="admin-record-panel audit-panel" data-record-browser data-page-size="12">
    <div class="audit-summary-strip"><span><strong>@Model.AuditLog.Count</strong> τελευταία συμβάντα</span><span><strong>@Model.AuditLog.Count(x => x.Category == "Security")</strong> ασφάλειας</span><span><strong>@Model.AuditLog.Count(x => !x.Succeeded)</strong> αποτυχημένα</span><span><strong>@Model.AuditLog.Count(x => x.Severity is "Critical" or "Warning")</strong> αυξημένης προσοχής</span></div>
    <div class="record-filter-bar">
        <label class="record-search"><span>Αναζήτηση audit</span><i class="fa-solid fa-magnifying-glass"></i><input data-record-search placeholder="Χρήστης, ενέργεια, entity, ID ή λεπτομέρειες" /></label>
        <label><span>Κατηγορία</span><select data-record-filter="category"><option value="all">Όλες</option>@foreach(var category in Model.AuditLog.Select(x => x.Category).Distinct().OrderBy(x => x)){<option value="@category.ToLowerInvariant()">@category</option>}</select></label>
        <label><span>Severity</span><select data-record-filter="severity"><option value="all">Όλα</option><option value="info">Info</option><option value="warning">Warning</option><option value="critical">Critical</option></select></label>
        <label><span>Περίοδος</span><select data-record-period><option value="all">Όλο το ιστορικό</option><option value="1">24 ώρες</option><option value="7">7 ημέρες</option><option value="30">30 ημέρες</option><option value="90">90 ημέρες</option></select></label>
        <strong class="record-count" data-record-count></strong>
    </div>
    <div class="table-wrap">
        <table class="data-table dense audit-table"><thead><tr><th>Χρόνος</th><th>Χρήστης</th><th>Ενέργεια</th><th>Κατηγορία</th><th>Entity</th><th>Αποτέλεσμα</th><th>Λεπτομέρειες</th></tr></thead><tbody>
        @foreach(var entry in Model.AuditLog)
        {
            var severityClass = entry.Severity.ToLowerInvariant();
            <tr data-record-row data-search="@(entry.ActorName.ToLowerInvariant()) @(entry.ActorEmail.ToLowerInvariant()) @(entry.Action.ToLowerInvariant()) @(entry.EntityName.ToLowerInvariant()) @(entry.EntityId.ToLowerInvariant()) @(entry.Details.ToLowerInvariant())" data-category="@entry.Category.ToLowerInvariant()" data-severity="@severityClass" data-date="@entry.Timestamp.ToString("yyyy-MM-dd")" data-detail-modal="audit-detail-modal" data-detail-time="@entry.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")" data-detail-actor="@entry.ActorName · @entry.ActorEmail" data-detail-action="@entry.Action" data-detail-category="@entry.Category · @entry.Severity" data-detail-entity="@entry.EntityName · @entry.EntityId" data-detail-result="@(entry.Succeeded ? "Επιτυχία" : "Αποτυχία")" data-detail-ip="@entry.IpAddress" data-detail-correlation="@entry.CorrelationId" data-detail-agent="@entry.UserAgent" data-detail-details="@entry.Details" tabindex="0">
                <td>@entry.Timestamp.ToLocalTime().ToString("dd/MM/yy HH:mm:ss")</td><td><strong>@entry.ActorName</strong><small>@entry.ActorEmail</small></td><td><strong>@entry.Action</strong></td><td><span class="audit-severity @severityClass">@entry.Category · @entry.Severity</span></td><td>@entry.EntityName<small>@entry.EntityId</small></td><td><span class="status-pill @(entry.Succeeded ? "active" : "closed")">@(entry.Succeeded ? "OK" : "FAILED")</span></td><td class="audit-details-cell">@entry.Details</td>
            </tr>
        }
        </tbody></table>
    </div>
    <div class="admin-filter-empty" data-record-empty hidden><i class="fa-solid fa-shield"></i> Δεν βρέθηκαν συμβάντα με αυτά τα φίλτρα.</div>
    <div class="record-pagination"><button type="button" data-record-prev><i class="fa-solid fa-chevron-left"></i></button><span data-record-page></span><button type="button" data-record-next><i class="fa-solid fa-chevron-right"></i></button></div>
</section>

<div class="dashboard-modal" id="audit-detail-modal" data-dashboard-modal hidden aria-hidden="true"><button class="dashboard-modal-backdrop" type="button" data-dashboard-modal-close></button><section class="dashboard-modal-dialog admin-detail-dialog" role="dialog" aria-modal="true" tabindex="-1"><header class="dashboard-modal-head"><span class="dashboard-modal-icon"><i class="fa-solid fa-shield-halved"></i></span><div><small>AUDIT EVENT</small><h2 data-record-field="action"></h2><p data-record-field="time"></p></div><button class="dashboard-modal-close" type="button" data-dashboard-modal-close><i class="fa-solid fa-xmark"></i></button></header><div class="admin-detail-grid"><div><small>Χρήστης</small><strong data-record-field="actor"></strong></div><div><small>Κατηγορία / severity</small><strong data-record-field="category"></strong></div><div><small>Entity</small><strong data-record-field="entity"></strong></div><div><small>Αποτέλεσμα</small><strong data-record-field="result"></strong></div><div><small>IP</small><strong data-record-field="ip"></strong></div><div><small>Correlation ID</small><strong data-record-field="correlation"></strong></div><div class="wide"><small>User agent</small><p data-record-field="agent"></p></div><div class="wide"><small>Πλήρεις λεπτομέρειες</small><p data-record-field="details"></p></div></div></section></div>

@* Versions link at bottom *@
<a class="alert-tile info" asp-controller="Versions" asp-action="Index" style="margin-top:36px">
    <div class="at-ic"><i class="fa-solid fa-box-archive"></i></div>
    <div class="at-body">
        <div class="at-title">Διαχείριση εκδόσεων πλατφόρμας</div>
        <div class="at-desc">Καταγράψτε νέα χαρακτηριστικά, βελτιώσεις και το ιστορικό της πλατφόρμας</div>
    </div>
    <div class="at-count"><i class="fa-solid fa-arrow-right"></i></div>
</a>
