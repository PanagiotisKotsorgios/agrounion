@model AgroUnion.Application.Contracts.ProducerDashboardDto
@using AgroUnion.Domain.Entities
@using System.Globalization
@using System.Text.Json
@{
    string CategoryName(ProducerCategory value) => value switch
    {
        ProducerCategory.Developing => "Κατηγορία Ε",
        ProducerCategory.Standard => "Κατηγορία Δ",
        ProducerCategory.Advanced => "Κατηγορία Γ",
        ProducerCategory.Premium => "Κατηγορία Β",
        ProducerCategory.Strategic => "Κατηγορία Α",
        _ => value.ToString()
    };
    string InvoiceStatusName(PartnerInvoiceStatus value) => value switch { PartnerInvoiceStatus.Draft => "Προσχέδιο", PartnerInvoiceStatus.Issued => "Εκδόθηκε", PartnerInvoiceStatus.PartiallyPaid => "Μερικώς εξοφλημένο", PartnerInvoiceStatus.Paid => "Εξοφλημένο", PartnerInvoiceStatus.Overdue => "Ληξιπρόθεσμο", PartnerInvoiceStatus.Cancelled => "Ακυρωμένο", _ => value.ToString() };
    string DocumentTypeName(PartnerDocumentType value) => value switch { PartnerDocumentType.ContractAnnex => "Παράρτημα σύμβασης", PartnerDocumentType.Certification => "Πιστοποίηση", PartnerDocumentType.TaxDocument => "Φορολογικό έγγραφο", PartnerDocumentType.DeliveryNote => "Δελτίο αποστολής", PartnerDocumentType.Statement => "Κατάσταση συνεργασίας", _ => "Λοιπό έγγραφο" };
    string FinancialCategoryName(FinancialEntryCategory value) => value switch { FinancialEntryCategory.ProductSale => "Αξία παραγωγής", FinancialEntryCategory.Supplies => "Εφόδια", FinancialEntryCategory.Bonus => "Πρόσθετη αξία", FinancialEntryCategory.Transport => "Μεταφορικά", FinancialEntryCategory.Services => "Υπηρεσίες", FinancialEntryCategory.Adjustment => "Τακτοποίηση", _ => "Άλλο" };
    string FinancialDescription(AgroUnion.Application.Contracts.PartnerFinancialEntryDto entry) => entry.Category == FinancialEntryCategory.Bonus
        ? entry.Description.Replace("Bonus", "Πρόσθετη αξία", StringComparison.OrdinalIgnoreCase)
        : entry.Description;
    string DealStatusName(DealStatus value) => value switch { DealStatus.Proposed => "Προς επιβεβαίωση", DealStatus.BuySideConfirmed => "Επιβεβαιώθηκε από εσάς", DealStatus.SellSideConfirmed => "Επιβεβαιώθηκε από αγοραστή", DealStatus.Completed => "Ολοκληρώθηκε", DealStatus.Cancelled => "Ακυρώθηκε", _ => value.ToString() };
    string ProductionStatusName(ProductionStatus value) => value switch { ProductionStatus.Available => "Διαθέσιμη", ProductionStatus.Reserved => "Δεσμευμένη", ProductionStatus.Sold => "Παραδόθηκε", _ => value.ToString() };
    string ContractStatusName(ContractStatus value) => value switch { ContractStatus.Draft => "Προσχέδιο", ContractStatus.Active => "Ενεργή", ContractStatus.Terminated => "Ολοκληρωμένη", _ => value.ToString() };
    string LogisticsStatusName(DeliveryLogisticsStatus value) => value switch { DeliveryLogisticsStatus.Scheduled => "Προγραμματισμένο", DeliveryLogisticsStatus.InTransit => "Σε μεταφορά", DeliveryLogisticsStatus.Weighed => "Ζυγίστηκε", DeliveryLogisticsStatus.Delivered => "Παραδόθηκε", DeliveryLogisticsStatus.Settled => "Εκκαθαρίστηκε", DeliveryLogisticsStatus.Cancelled => "Ακυρώθηκε", _ => value.ToString() };
    string PaymentStatusName(DeliveryPaymentStatus value) => value switch { DeliveryPaymentStatus.Pending => "Σε αναμονή", DeliveryPaymentStatus.PartiallyPaid => "Μερική πληρωμή", DeliveryPaymentStatus.Paid => "Εξοφλημένο", DeliveryPaymentStatus.OnHold => "Σε αναστολή", _ => value.ToString() };

    var p = Model.Profile;
    var f = Model.FinancialSummary;
    var page = (ViewData["ProducerPage"] as string ?? "overview").ToLowerInvariant();
    var logistics = Model.LogisticsSummary;

    var completedDeliveries = Model.DeliveryRecords.Count > 0 ? logistics.CompletedRoutes : Model.Deals.Count(x => x.Status == DealStatus.Completed);
    var pendingDeals = Model.Deals.Count(x => x.Status == DealStatus.Proposed || x.Status == DealStatus.SellSideConfirmed);
    var overdueInvoices = Model.Invoices.Count(x => x.Status == PartnerInvoiceStatus.Overdue);
    var todayDo = DateOnly.FromDateTime(DateTime.Today);
    var soonDo = DateOnly.FromDateTime(DateTime.Today.AddDays(60));
    var expiringDocs = Model.Documents.Count(x => x.ExpiryDate.HasValue && x.ExpiryDate.Value <= soonDo && x.ExpiryDate.Value >= todayDo);
    var deliveryPct = f.DeclaredProduction > 0 ? Math.Min(100, (int)((double)f.DeliveredProduction / (double)f.DeclaredProduction * 100)) : 0;
    var paidPct = logistics.NetPayable > 0 ? Math.Min(100, (int)((double)logistics.Paid / (double)logistics.NetPayable * 100)) : 0;
    var chartMonths = Enumerable.Range(0, 6)
        .Select(offset => new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(offset - 5))
        .ToArray();
    var chartLabels = chartMonths.Select(x => x.ToString("MMM", new CultureInfo("el-GR"))).ToArray();
    var chartWeights = chartMonths.Select(month => Model.DeliveryRecords
        .Where(x => x.ScheduledPickupAt.Year == month.Year && x.ScheduledPickupAt.Month == month.Month)
        .Sum(x => x.AcceptedWeight)).ToArray();
    var chartRevenue = chartMonths.Select(month => Model.DeliveryRecords
        .Where(x => x.ScheduledPickupAt.Year == month.Year && x.ScheduledPickupAt.Month == month.Month)
        .Sum(x => x.NetPayableAmount)).ToArray();
    var deliveriesForTable = Model.DeliveryRecords.OrderByDescending(x => x.ScheduledPickupAt).ToList();

    decimal CategoryTargetKg(ProducerCategory category) => category switch
    {
        ProducerCategory.Developing => 3000m,
        ProducerCategory.Standard => 10000m,
        ProducerCategory.Advanced => 20000m,
        ProducerCategory.Premium => 50000m,
        _ => 0m
    };
    decimal CategoryLowerBoundKg(ProducerCategory category) => category switch
    {
        ProducerCategory.Standard => 3000m,
        ProducerCategory.Advanced => 10000m,
        ProducerCategory.Premium => 20000m,
        ProducerCategory.Strategic => 50000m,
        _ => 0m
    };
    bool PriceMatchesProduction(AgroUnion.Application.Contracts.PriceItemDto price)
    {
        if (price.Category != PriceCategory.Product) return false;
        if (Model.Declarations.Count == 0) return true;
        var priceName = price.ProductName.ToLowerInvariant();
        return Model.Declarations.Any(declaration =>
        {
            var product = declaration.Product.ToLowerInvariant();
            return priceName.Contains(product) || product.Contains(priceName)
                || ((product.Contains("ελαιόλαδο") || product.Contains("λάδι")) && (priceName.Contains("ελαιόλαδο") || priceName.Contains("λάδι")))
                || ((product.Contains("ελιά") || product.Contains("καλαμών")) && (priceName.Contains("ελιά") || priceName.Contains("καλαμών")))
                || (product.Contains("εσπεριδο") && (priceName.Contains("πορτοκ") || priceName.Contains("μανταρ") || priceName.Contains("λεμόν") || priceName.Contains("εσπεριδο")));
        });
    }

    var categoryTargetKg = CategoryTargetKg(p.Category);
    var annualAcceptedKg = Model.DeliveryRecords
        .Where(x => x.ScheduledPickupAt.Year == DateTime.Today.Year && x.Status != DeliveryLogisticsStatus.Cancelled)
        .Sum(x => x.AcceptedWeight);
    var categoryLowerBoundKg = CategoryLowerBoundKg(p.Category);
    var categoryProgress = categoryTargetKg > categoryLowerBoundKg
        ? Math.Clamp((int)Math.Round((annualAcceptedKg - categoryLowerBoundKg) / (categoryTargetKg - categoryLowerBoundKg) * 100m), 0, 100)
        : 100;
    var categoryCreditedKg = annualAcceptedKg;
    var categoryRemainingKg = Math.Max(0, categoryTargetKg - annualAcceptedKg);
    var qualityRequirements = p.UpgradeRequirements;
    if (qualityRequirements.Contains("kg", StringComparison.OrdinalIgnoreCase) && qualityRequirements.Contains(','))
    {
        qualityRequirements = qualityRequirements[(qualityRequirements.IndexOf(',') + 1)..].Trim();
        if (qualityRequirements.Length > 0) qualityRequirements = char.ToUpper(qualityRequirements[0], new CultureInfo("el-GR")) + qualityRequirements[1..];
    }

    var activeProducerOffers = Model.Offers
        .Where(x => x.Status == OfferStatus.Active && x.ValidUntil >= DateTime.Now)
        .OrderByDescending(x => x.BuyPricePerUnit)
        .ToList();
    var relevantAdminPrices = Model.PriceList
        .Where(x => x.EffectiveFrom <= todayDo && (!x.EffectiveTo.HasValue || x.EffectiveTo.Value >= todayDo) && PriceMatchesProduction(x))
        .OrderBy(x => x.ProductName)
        .ToList();
    var displayedPriceCount = activeProducerOffers.Count + relevantAdminPrices.Count;
    var highestPublishedPrice = activeProducerOffers.Select(x => x.BuyPricePerUnit)
        .Concat(relevantAdminPrices.Select(x => x.Price))
        .DefaultIfEmpty(f.AverageDeliveryPrice)
        .Max();
    var visibleFinancialEntries = Model.FinancialEntries
        .Where(x => x.Category != FinancialEntryCategory.Commission)
        .OrderByDescending(x => x.EntryDate)
        .ToList();
    var priceHistoryDeals = Model.Deals
        .Where(x => x.Status != DealStatus.Cancelled)
        .OrderBy(x => x.CreatedAt)
        .TakeLast(10)
        .ToList();
    var productionMix = Model.Declarations
        .GroupBy(x => x.Product)
        .Select(x => new { Product = x.Key, Quantity = x.Sum(item => item.Quantity) })
        .OrderByDescending(x => x.Quantity)
        .ToList();
    var financeIncome = chartMonths.Select(month => visibleFinancialEntries
        .Where(x => x.EntryDate.Year == month.Year && x.EntryDate.Month == month.Month && x.Type == FinancialEntryType.Income)
        .Sum(x => x.Amount)).ToArray();
    var financeExpenses = chartMonths.Select(month => visibleFinancialEntries
        .Where(x => x.EntryDate.Year == month.Year && x.EntryDate.Month == month.Month && x.Type == FinancialEntryType.Expense)
        .Sum(x => x.Amount)).ToArray();
}

@* OVERVIEW — minimal, focused on 4 KPIs, recent deliveries, activity *@
@if (page == "overview")
{
    @* Only show alerts if there are real items *@
    @if (pendingDeals > 0 || overdueInvoices > 0 || expiringDocs > 0)
    {
        <div class="alerts-strip">
            @if (pendingDeals > 0)
            {
                <a class="alert-tile warning" asp-action="ProducerPage" asp-route-page="production">
                    <div class="at-ic"><i class="fa-solid fa-hourglass-half"></i></div>
                    <div class="at-body">
                        <div class="at-title">Εκκρεμούν επιβεβαιώσεις</div>
                        <div class="at-desc">Συμφωνίες προς έγκριση</div>
                    </div>
                    <div class="at-count">@pendingDeals</div>
                </a>
            }
            @if (overdueInvoices > 0)
            {
                <a class="alert-tile danger" asp-action="ProducerPage" asp-route-page="invoices">
                    <div class="at-ic"><i class="fa-solid fa-triangle-exclamation"></i></div>
                    <div class="at-body">
                        <div class="at-title">Ληξιπρόθεσμα τιμολόγια</div>
                        <div class="at-desc">Άμεση ενέργεια</div>
                    </div>
                    <div class="at-count">@overdueInvoices</div>
                </a>
            }
            @if (expiringDocs > 0)
            {
                <a class="alert-tile info" asp-action="ProducerPage" asp-route-page="documents">
                    <div class="at-ic"><i class="fa-solid fa-file-shield"></i></div>
                    <div class="at-body">
                        <div class="at-title">Έγγραφα προς ανανέωση</div>
                        <div class="at-desc">Λήγουν εντός 60 ημερών</div>
                    </div>
                    <div class="at-count">@expiringDocs</div>
                </a>
            }
        </div>
    }

    @* 4 BIG KPI cards — the essentials only *@
    <div class="kpi-pro-grid producer-overview-kpis">
        <article class="kpi-pro hero-card">
            <div class="kpi-pro-head">
                <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-coins"></i></span><span>Καθαρή αξία παραδόσεων</span></div>
            </div>
            <div class="kpi-pro-value">@f.DeliveryRevenue.ToString("N0") <span class="unit">€</span></div>
            <div class="kpi-pro-sub"><strong>@completedDeliveries</strong> ολοκληρωμένες παραδόσεις</div>
        </article>

        <article class="kpi-pro">
            <div class="kpi-pro-head">
                <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-wheat-awn"></i></span><span>Παραδοτέος όγκος</span></div>
                <span class="kpi-pro-trend up">@deliveryPct%</span>
            </div>
            <div class="kpi-pro-value">@f.DeliveredProduction.ToString("N0") <span class="unit">kg</span></div>
            <div class="kpi-pro-progress"><i style="width:@deliveryPct%"></i></div>
        </article>

        <article class="kpi-pro">
            <div class="kpi-pro-head">
                <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-truck-fast"></i></span><span>Δρομολόγια</span></div>
                <span class="kpi-pro-trend flat">@logistics.ActiveRoutes ενεργά</span>
            </div>
            <div class="kpi-pro-value">@logistics.TotalRoutes</div>
            <div class="kpi-pro-sub"><strong>@logistics.CompletedRoutes</strong> ολοκληρωμένα</div>
        </article>

        <article class="kpi-pro">
            <div class="kpi-pro-head">
                <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-wallet"></i></span><span>Πληρωμές</span></div>
                <span class="kpi-pro-trend @(logistics.Outstanding > 0 ? "down" : "up")">@paidPct%</span>
            </div>
            <div class="kpi-pro-value">@logistics.NetPayable.ToString("N0") <span class="unit">€</span></div>
            <div class="kpi-pro-progress @(logistics.Outstanding > 0 ? "brass" : "")"><i style="width:@paidPct%"></i></div>
        </article>
    </div>

    <section class="producer-chart-grid" aria-label="Διαγράμματα απόδοσης συνεργασίας">
        <article class="producer-chart-card producer-chart-card-wide">
            <header>
                <div>
                    <small>ΕΞΑΜΗΝΙΑΙΑ ΕΙΚΟΝΑ</small>
                    <h2>Παραδόσεις και καθαρή αξία</h2>
                </div>
                <span><i class="fa-solid fa-chart-line"></i> Ενημέρωση από το Portal</span>
            </header>
            <div class="producer-chart-canvas producer-chart-canvas-wide">
                <canvas data-producer-chart="deliveries"
                        role="img"
                        aria-label="Διάγραμμα παραδοτέου όγκου και καθαρής αξίας εξαμήνου"
                        data-labels="@JsonSerializer.Serialize(chartLabels)"
                        data-weights="@JsonSerializer.Serialize(chartWeights)"
                        data-revenue="@JsonSerializer.Serialize(chartRevenue)"></canvas>
            </div>
            <footer>
                <span><i class="chart-key weight"></i> Παραδοτέος όγκος (kg)</span>
                <span><i class="chart-key revenue"></i> Καθαρή αξία (€)</span>
            </footer>
        </article>

        <article class="producer-chart-card producer-payment-chart">
            <header>
                <div>
                    <small>ΟΙΚΟΝΟΜΙΚΗ ΡΟΗ</small>
                    <h2>Κατάσταση πληρωμών</h2>
                </div>
            </header>
            <div class="producer-doughnut-wrap">
                <div class="producer-chart-canvas producer-chart-canvas-round">
                    <canvas data-producer-chart="payments"
                            role="img"
                            aria-label="Διάγραμμα πληρωμένων ποσών και ανοιχτού υπολοίπου"
                            data-paid="@logistics.Paid.ToString(CultureInfo.InvariantCulture)"
                            data-outstanding="@logistics.Outstanding.ToString(CultureInfo.InvariantCulture)"></canvas>
                    <div class="producer-chart-center"><strong>@paidPct%</strong><span>εξοφλημένο</span></div>
                </div>
                <dl>
                    <div><dt>Πληρωμένα</dt><dd>@logistics.Paid.ToString("N0") €</dd></div>
                    <div><dt>Υπόλοιπο</dt><dd>@logistics.Outstanding.ToString("N0") €</dd></div>
                </dl>
            </div>
        </article>
    </section>

    @* Recent deliveries — simple table, 5 latest *@
    @if (Model.DeliveryRecords.Any())
    {
        <div class="section-title">
            <h2>Πρόσφατες παραδόσεις</h2>
            <div class="rule"></div>
            <a class="more" asp-action="ProducerPage" asp-route-page="logistics">Όλες <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        <div class="delivery-table-panel" data-delivery-table data-page-size="5">
            <div class="delivery-table-tools">
                <label class="delivery-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="search" data-delivery-search placeholder="Αναζήτηση σε δρομολόγιο, προϊόν ή κατάσταση" autocomplete="off" />
                </label>
                <span data-delivery-count>@deliveriesForTable.Count παραδόσεις</span>
            </div>
            <div class="table-wrap">
            <table class="data-table pro">
                <thead>
                    <tr>
                        <th>Δρομολόγιο</th>
                        <th>Προϊόν</th>
                        <th class="right">Βάρος</th>
                        <th class="right">Αξία</th>
                        <th>Κατάσταση</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in deliveriesForTable)
                    {
                        <tr class="delivery-click-row"
                            tabindex="0"
                            role="button"
                            aria-label="Προβολή λεπτομερειών για το δρομολόγιο @r.RouteNumber"
                            data-delivery-row
                            data-search="@($"{r.RouteNumber} {r.Product} {r.Variety} {LogisticsStatusName(r.Status)} {r.OriginAddress} {r.DestinationAddress} {r.FactoryName}".ToLowerInvariant())"
                            data-route="@r.RouteNumber"
                            data-product="@r.Product"
                            data-variety="@(string.IsNullOrWhiteSpace(r.Variety) ? "—" : r.Variety)"
                            data-status="@LogisticsStatusName(r.Status)"
                            data-scheduled="@r.ScheduledPickupAt.ToString("dd/MM/yyyy · HH:mm")"
                            data-origin="@r.OriginAddress"
                            data-destination="@r.DestinationAddress"
                            data-factory="@(string.IsNullOrWhiteSpace(r.FactoryName) ? "—" : r.FactoryName)"
                            data-loaded="@(r.LoadedAt?.ToString("dd/MM/yyyy · HH:mm") ?? "—")"
                            data-delivered="@(r.DeliveredAt?.ToString("dd/MM/yyyy · HH:mm") ?? "—")"
                            data-loadedweight="@($"{r.NetWeight:N0} {r.WeightUnit}")"
                            data-weight="@($"{r.AcceptedWeight:N0} {r.WeightUnit}")"
                            data-unitprice="@($"{r.UnitPrice:N4} €/{r.WeightUnit}")"
                            data-value="@($"{r.NetPayableAmount:N2} €")"
                            data-paid="@($"{r.PaidAmount:N2} €")"
                            data-outstanding="@($"{r.OutstandingAmount:N2} €")"
                            data-carrier="@(string.IsNullOrWhiteSpace(r.CarrierName) ? "—" : r.CarrierName)"
                            data-vehicle="@(string.IsNullOrWhiteSpace(r.VehiclePlate) ? "—" : r.VehiclePlate)"
                            data-agreement="@(string.IsNullOrWhiteSpace(r.AgreementReference) ? "—" : r.AgreementReference)">
                            <td>
                                <div class="cell-avatar">
                                    <div class="av"><i class="fa-solid fa-truck"></i></div>
                                    <div class="info">
                                        <strong>@r.RouteNumber</strong>
                                        <small>@r.ScheduledPickupAt.ToString("dd/MM/yy")</small>
                                    </div>
                                </div>
                            </td>
                            <td><strong>@r.Product</strong></td>
                            <td class="right num">@r.AcceptedWeight.ToString("N0") @r.WeightUnit</td>
                            <td class="right num pos">@r.NetPayableAmount.ToString("N0") €</td>
                            <td><span class="status-pill @r.Status.ToString().ToLowerInvariant()">@LogisticsStatusName(r.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            <div class="delivery-empty-search" data-delivery-empty hidden>
                <i class="fa-solid fa-magnifying-glass"></i>
                <span>Δεν βρέθηκαν παραδόσεις με αυτά τα κριτήρια.</span>
            </div>
            <div class="delivery-pagination" data-delivery-pagination>
                <button type="button" data-delivery-prev aria-label="Προηγούμενη σελίδα"><i class="fa-solid fa-chevron-left"></i></button>
                <span data-delivery-page>Σελίδα 1 από 1</span>
                <button type="button" data-delivery-next aria-label="Επόμενη σελίδα"><i class="fa-solid fa-chevron-right"></i></button>
            </div>
        </div>

        <div class="dashboard-modal" id="delivery-details-modal" data-dashboard-modal hidden aria-hidden="true">
            <button class="dashboard-modal-backdrop" type="button" data-dashboard-modal-close aria-label="Κλείσιμο"></button>
            <section class="dashboard-modal-dialog delivery-detail-dialog" role="dialog" aria-modal="true" aria-labelledby="delivery-detail-title" tabindex="-1">
                <header class="dashboard-modal-head delivery-detail-head">
                    <span class="dashboard-modal-icon"><i class="fa-solid fa-truck-fast"></i></span>
                    <div>
                        <small>ΚΑΡΤΕΛΑ ΠΑΡΑΔΟΣΗΣ</small>
                        <h2 id="delivery-detail-title" data-delivery-field="route">—</h2>
                        <p><span data-delivery-field="product">—</span> · <span data-delivery-field="status">—</span></p>
                    </div>
                    <button class="dashboard-modal-close" type="button" data-dashboard-modal-close aria-label="Κλείσιμο"><i class="fa-solid fa-xmark"></i></button>
                </header>
                <div class="delivery-detail-body">
                    <section>
                        <h3>Στοιχεία δρομολογίου</h3>
                        <dl class="delivery-detail-grid">
                            <div><dt>Προγραμματισμένη παραλαβή</dt><dd data-delivery-field="scheduled">—</dd></div>
                            <div><dt>Ποικιλία</dt><dd data-delivery-field="variety">—</dd></div>
                            <div><dt>Πραγματική φόρτωση</dt><dd data-delivery-field="loaded">—</dd></div>
                            <div><dt>Παράδοση</dt><dd data-delivery-field="delivered">—</dd></div>
                            <div><dt>Αφετηρία</dt><dd data-delivery-field="origin">—</dd></div>
                            <div><dt>Προορισμός</dt><dd data-delivery-field="destination">—</dd></div>
                            <div class="full"><dt>Εργοστάσιο παραλαβής</dt><dd data-delivery-field="factory">—</dd></div>
                            <div><dt>Μεταφορέας</dt><dd data-delivery-field="carrier">—</dd></div>
                            <div><dt>Όχημα</dt><dd data-delivery-field="vehicle">—</dd></div>
                        </dl>
                    </section>
                    <section>
                        <h3>Ποσότητα και εκκαθάριση</h3>
                        <dl class="delivery-detail-grid financial">
                            <div><dt>Φορτωμένο καθαρό βάρος</dt><dd data-delivery-field="loadedweight">—</dd></div>
                            <div><dt>Αποδεκτό βάρος</dt><dd data-delivery-field="weight">—</dd></div>
                            <div><dt>Τιμή παραγωγού</dt><dd data-delivery-field="unitprice">—</dd></div>
                            <div><dt>Καθαρή αξία</dt><dd data-delivery-field="value">—</dd></div>
                            <div><dt>Πληρωμένο</dt><dd data-delivery-field="paid">—</dd></div>
                            <div><dt>Υπόλοιπο</dt><dd data-delivery-field="outstanding">—</dd></div>
                            <div class="full"><dt>Συμφωνία</dt><dd data-delivery-field="agreement">—</dd></div>
                        </dl>
                    </section>
                </div>
            </section>
        </div>
    }

    @* Bottom CTA *@
    <div style="display:flex;justify-content:center;margin-top:44px">
        <a class="btn btn-lg" asp-action="ProducerPage" asp-route-page="production"><i class="fa-solid fa-plus"></i> Νέα δήλωση παραγωγής</a>
    </div>
}

@* COLLABORATION — category, kilogram target and producer-facing purchase prices *@
@if (page == "collaboration")
{
    <div class="producer-relationship-hero collaboration-command" style="margin-top:0">
        <div class="relationship-copy">
            <span class="relationship-kicker"><i class="fa-solid fa-shield-heart"></i> Ο προσωπικός σας φάκελος συνεργασίας</span>
            <h2>@p.ProducerName</h2>
            <p>Κατηγορία συνεργασίας, στόχος παράδοσης και οι τιμές αγοράς που ισχύουν για τη δική σας παραγωγή.</p>
            <div class="relationship-meta">
                <span><i class="fa-solid fa-location-dot"></i> @p.Region</span>
                <span><i class="fa-solid fa-calendar-check"></i> Από @p.RelationshipStartDate.ToString("dd/MM/yyyy")</span>
                <span><i class="fa-solid fa-user-tie"></i> @p.AccountManager</span>
            </div>
        </div>
        <div class="relationship-tier">
            <div class="tier-symbol"><i class="fa-solid fa-medal"></i></div>
            <small>Τρέχουσα κατηγορία</small>
            <strong>@CategoryName(p.Category)</strong>
            @if (p.NextCategory is { } next)
            {
                <div class="tier-progress-head"><span>Επόμενη: @CategoryName(next)</span><b>@categoryRemainingKg.ToString("N0") kg ακόμη</b></div>
                <div class="tier-progress" role="progressbar" aria-label="Πρόοδος προς @CategoryName(next)" aria-valuenow="@categoryProgress" aria-valuemin="0" aria-valuemax="100"><i style="width:@categoryProgress%"></i></div>
            }
        </div>
    </div>

    <div class="producer-stat-strip collaboration-stats">
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-bullseye"></i></span><span>Στόχος κατηγορίας</span></div>
            <div class="kpi-pro-value">@categoryTargetKg.ToString("N0") <span class="unit">kg</span></div>
            <div class="kpi-pro-sub">Συνολικός όγκος για @(p.NextCategory is { } targetCategory ? CategoryName(targetCategory) : "την επόμενη αξιολόγηση")</div>
        </article>
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-scale-balanced"></i></span><span>Υπολογισμένος όγκος</span></div>
            <div class="kpi-pro-value">@categoryCreditedKg.ToString("N0") <span class="unit">kg</span></div>
            <div class="kpi-pro-sub">Παραδόσεις προς AGRO UNION το @DateTime.Today.Year</div>
        </article>
        <article class="kpi-pro emphasis">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-truck-ramp-box"></i></span><span>Υπόλοιπο στόχου</span></div>
            <div class="kpi-pro-value">@categoryRemainingKg.ToString("N0") <span class="unit">kg</span></div>
            <div class="kpi-pro-sub">Απαιτούνται για την επόμενη κατηγορία</div>
        </article>
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-tag"></i></span><span>Υψηλότερη ενεργή τιμή</span></div>
            <div class="kpi-pro-value">@highestPublishedPrice.ToString("N3") <span class="unit">€/kg</span></div>
            <div class="kpi-pro-sub">Από τις τιμές που αφορούν τη δική σας παραγωγή</div>
        </article>
    </div>

    <section class="category-program">
        <div class="category-program-copy">
            <span class="eyebrow">ΠΡΟΓΡΑΜΜΑ ΚΑΤΗΓΟΡΙΑΣ</span>
            <h2>Πώς περνάτε στην επόμενη κατηγορία</h2>
            @if (p.NextCategory is { } nextCategory)
            {
                <p>Με την παράδοση ακόμη <strong>@categoryRemainingKg.ToString("N0") kg</strong> — από συνολικό στόχο <strong>@categoryTargetKg.ToString("N0") kg</strong> — ο λογαριασμός σας αξιολογείται για την κατηγορία <strong>@CategoryName(nextCategory)</strong>.</p>
                <p>Με την αναβάθμιση εφαρμόζονται οι τιμές αγοράς της νέας κατηγορίας ανά προϊόν, ποιότητα και διαλογή, όπως δημοσιεύονται από τη διαχείριση.</p>
            }
            else
            {
                <p>Βρίσκεστε στην ανώτερη διαθέσιμη κατηγορία συνεργασίας. Οι τιμές σας συνεχίζουν να ενημερώνονται ανά προϊόν, ποιότητα και διαλογή.</p>
            }
        </div>
        <div class="category-requirements">
            <span><i class="fa-solid fa-clipboard-check"></i> Ποιοτικά κριτήρια</span>
            <p>@qualityRequirements</p>
            <small>Η τελική αξιολόγηση επιβεβαιώνεται από την υπεύθυνη ομάδα συνεργασιών.</small>
        </div>
    </section>

    <div class="section-title producer-section-heading">
        <div>
            <small>ΤΙΜΕΣ ΠΑΡΑΓΩΓΟΥ</small>
            <h2>Τι αγοράζουμε και πόσο λαμβάνετε</h2>
        </div>
        <div class="rule"></div>
        <span class="pill-metric"><strong>@displayedPriceCount</strong> ενεργές τιμές</span>
    </div>
    <section class="producer-price-panel" data-producer-prices>
        <div class="producer-filter-bar">
            <label class="delivery-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search" placeholder="Αναζήτηση προϊόντος, ποιότητας ή μεγέθους" data-price-search />
            </label>
            <label class="producer-filter-select">
                <span>Πηγή τιμής</span>
                <select data-price-source>
                    <option value="all">Όλες</option>
                    <option value="personal">Προσωπικές προσφορές</option>
                    <option value="catalog">Τιμοκατάλογος</option>
                </select>
            </label>
            <span class="producer-filter-count" data-price-count>@displayedPriceCount εγγραφές</span>
        </div>
        <div class="table-wrap producer-price-table-wrap">
            <table class="data-table pro producer-price-table">
                <thead>
                    <tr><th>Προϊόν · ποιότητα / μέγεθος</th><th>Κατηγορία τιμής</th><th>Ποσότητα</th><th>Ισχύς</th><th class="right">Τιμή που λαμβάνετε</th></tr>
                </thead>
                <tbody>
                    @foreach (var offer in activeProducerOffers)
                    {
                        <tr data-price-row data-source="personal" data-search="@offer.Product.ToLowerInvariant() προσωπική προσφορά">
                            <td><strong>@offer.Product</strong><small>Εξατομικευμένη προσφορά λογαριασμού</small></td>
                            <td><span class="price-source-badge personal"><i class="fa-solid fa-user-check"></i> Προσωπική</span></td>
                            <td class="num">@offer.TargetQuantity.ToString("N0") kg</td>
                            <td>έως @offer.ValidUntil.ToString("dd/MM/yyyy")</td>
                            <td class="right"><strong class="producer-buy-price">@offer.BuyPricePerUnit.ToString("N3") €/kg</strong></td>
                        </tr>
                    }
                    @foreach (var price in relevantAdminPrices)
                    {
                        <tr data-price-row data-source="catalog" data-search="@price.ProductName.ToLowerInvariant() τιμοκατάλογος">
                            <td><strong>@price.ProductName</strong><small>Τιμή ανά δηλωμένη ποιότητα ή διαλογή</small></td>
                            <td><span class="price-source-badge catalog"><i class="fa-solid fa-list-check"></i> Τιμοκατάλογος</span></td>
                            <td>—</td>
                            <td>@price.EffectiveFrom.ToString("dd/MM/yyyy")@(price.EffectiveTo.HasValue ? $" – {price.EffectiveTo.Value:dd/MM/yyyy}" : " και μετά")</td>
                            <td class="right"><strong class="producer-buy-price">@price.Price.ToString("N3") €/@price.Unit</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="producer-table-empty" data-price-empty hidden><i class="fa-solid fa-filter-circle-xmark"></i> Δεν βρέθηκαν τιμές με αυτά τα φίλτρα.</div>
        @if (displayedPriceCount == 0)
        {
            <div class="portal-empty compact"><i class="fa-solid fa-tags"></i><span>Δεν υπάρχει ακόμη ενεργή τιμή για τα προϊόντα σας. Η νέα τιμή θα εμφανιστεί εδώ μόλις δημοσιευτεί.</span></div>
        }
        <footer><i class="fa-solid fa-circle-info"></i> Εμφανίζονται αποκλειστικά οι τιμές αγοράς που ισχύουν για τον δικό σας λογαριασμό και τα δηλωμένα προϊόντα σας.</footer>
    </section>

    <div class="producer-chart-grid collaboration-chart-grid">
        <article class="producer-chart-card">
            <header><div><small>ΤΙΜΕΣ ΑΓΟΡΑΣ</small><h2>Εξέλιξη τιμής ανά συμφωνία</h2></div><span><i class="fa-solid fa-chart-line"></i> €/kg</span></header>
            <div class="producer-chart-canvas producer-chart-canvas-wide"><canvas data-producer-chart="price-history" data-labels='@JsonSerializer.Serialize(priceHistoryDeals.Select(x => x.CreatedAt.ToString("dd/MM")).ToArray())' data-values='@JsonSerializer.Serialize(priceHistoryDeals.Select(x => x.BuyPricePerUnit).ToArray())'></canvas></div>
        </article>
        <article class="producer-chart-card">
            <header><div><small>ΠΑΡΑΓΩΓΙΚΟ ΜΕΙΓΜΑ</small><h2>Δηλωμένος όγκος ανά προϊόν</h2></div><span><i class="fa-solid fa-chart-pie"></i> kg</span></header>
            <div class="producer-chart-canvas producer-chart-canvas-wide"><canvas data-producer-chart="production-mix" data-labels='@JsonSerializer.Serialize(productionMix.Select(x => x.Product).ToArray())' data-values='@JsonSerializer.Serialize(productionMix.Select(x => x.Quantity).ToArray())'></canvas></div>
        </article>
    </div>

    <div class="section-title producer-section-heading">
        <h2>Όροι λογαριασμού</h2>
        <div class="rule"></div>
    </div>
    <div class="producer-account-terms">
        <article>
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-clock"></i></span><span>Όροι πληρωμής</span></div>
            <strong>@p.PaymentTerms</strong>
        </article>
        <article>
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-headset"></i></span><span>Υπεύθυνος</span></div>
            <strong>@p.AccountManager</strong>
        </article>
        <article>
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-rotate"></i></span><span>Τελευταία ενημέρωση</span></div>
            <strong>@(p.UpdatedAt?.ToString("dd/MM/yyyy") ?? "—")</strong>
        </article>
    </div>
}

@* FINANCES — producer-facing value, payments, charts and searchable ledger *@
@if (page == "finances")
{
    <div class="producer-stat-strip finance-stats">
        <article class="kpi-pro emphasis">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-sack-dollar"></i></span><span>Αξία παραδόσεων</span></div>
            <div class="kpi-pro-value">@f.DeliveryRevenue.ToString("N0") <span class="unit">€</span></div>
            <div class="kpi-pro-sub">Συνολική αξία της παραγωγής που παραδόθηκε</div>
        </article>
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-circle-check"></i></span><span>Πληρωμένο ποσό</span></div>
            <div class="kpi-pro-value">@logistics.Paid.ToString("N0") <span class="unit">€</span></div>
            <div class="kpi-pro-sub">Ποσό που έχει ήδη εξοφληθεί</div>
        </article>
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-hourglass-half"></i></span><span>Ανοιχτό υπόλοιπο</span></div>
            <div class="kpi-pro-value">@logistics.Outstanding.ToString("N0") <span class="unit">€</span></div>
            <div class="kpi-pro-sub">Προς εξόφληση σύμφωνα με τους όρους σας</div>
        </article>
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-tag"></i></span><span>Μέση τιμή αγοράς</span></div>
            <div class="kpi-pro-value">@f.AverageDeliveryPrice.ToString("N3") <span class="unit">€/kg</span></div>
            <div class="kpi-pro-sub">Με βάση τις ολοκληρωμένες παραδόσεις</div>
        </article>
    </div>

    <div class="producer-chart-grid finance-chart-grid">
        <article class="producer-chart-card">
            <header><div><small>ΟΙΚΟΝΟΜΙΚΗ ΡΟΗ</small><h2>Αξίες ανά μήνα</h2></div><span><i class="fa-solid fa-chart-column"></i> τελευταίο εξάμηνο</span></header>
            <div class="producer-chart-canvas producer-chart-canvas-wide"><canvas data-producer-chart="finance-flow" data-labels='@JsonSerializer.Serialize(chartLabels)' data-income='@JsonSerializer.Serialize(financeIncome)' data-expenses='@JsonSerializer.Serialize(financeExpenses)'></canvas></div>
            <footer><span><i class="chart-key income"></i> Πιστώσεις παραγωγού</span><span><i class="chart-key expense"></i> Λοιπές χρεώσεις</span></footer>
        </article>
        <article class="producer-chart-card producer-payment-chart">
            <header><div><small>ΕΞΟΦΛΗΣΗ</small><h2>Κατάσταση πληρωμών</h2></div><span><i class="fa-solid fa-wallet"></i> τρέχουσα εικόνα</span></header>
            <div class="producer-doughnut-wrap">
                <div class="producer-chart-canvas producer-chart-canvas-round">
                    <canvas data-producer-chart="finance-status" data-paid="@logistics.Paid.ToString(CultureInfo.InvariantCulture)" data-outstanding="@logistics.Outstanding.ToString(CultureInfo.InvariantCulture)"></canvas>
                    <div class="producer-chart-center"><strong>@paidPct%</strong><span>εξοφλημένο</span></div>
                </div>
                <dl><div><dt>Πληρωμένα</dt><dd>@logistics.Paid.ToString("N0") €</dd></div><div><dt>Υπόλοιπο</dt><dd>@logistics.Outstanding.ToString("N0") €</dd></div></dl>
            </div>
        </article>
    </div>

    <div class="section-title producer-section-heading">
        <div><small>ΑΝΑΛΥΤΙΚΗ ΚΑΡΤΕΛΑ</small><h2>Κινήσεις λογαριασμού</h2></div>
        <div class="rule"></div>
        <a class="more" asp-action="TransactionsCsv"><i class="fa-solid fa-file-csv"></i> Εξαγωγή CSV</a>
    </div>
    <section class="finance-ledger-panel" data-finance-ledger data-page-size="8">
        <div class="producer-filter-bar finance-filter-bar">
            <label class="delivery-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" placeholder="Αναζήτηση περιγραφής ή αναφοράς" data-finance-search /></label>
            <label class="producer-filter-select"><span>Κατηγορία</span><select data-finance-category><option value="all">Όλες</option><option value="ProductSale">Αξία παραγωγής</option><option value="Bonus">Πρόσθετη αξία</option><option value="Supplies">Εφόδια</option><option value="Transport">Μεταφορικά</option><option value="Services">Υπηρεσίες</option><option value="Adjustment">Τακτοποίηση</option><option value="Other">Άλλο</option></select></label>
            <label class="producer-filter-select"><span>Τύπος</span><select data-finance-type><option value="all">Όλοι</option><option value="Income">Πίστωση</option><option value="Expense">Χρέωση</option></select></label>
            <label class="producer-filter-select"><span>Περίοδος</span><select data-finance-period><option value="all">Όλο το ιστορικό</option><option value="30">30 ημέρες</option><option value="90">90 ημέρες</option><option value="365">12 μήνες</option></select></label>
            <span class="producer-filter-count" data-finance-count>@visibleFinancialEntries.Count κινήσεις</span>
        </div>
        <div class="table-wrap">
            <table class="data-table pro producer-finance-table">
                <thead><tr><th>Ημερομηνία</th><th>Κίνηση</th><th>Κατηγορία</th><th>Περιγραφή / αναφορά</th><th class="right">Ποσό</th></tr></thead>
                <tbody>
                    @foreach (var entry in visibleFinancialEntries)
                    {
                        <tr data-finance-row data-search="@($"{FinancialDescription(entry)} {entry.ReferenceNumber}").ToLowerInvariant()" data-category="@entry.Category" data-type="@entry.Type" data-date="@entry.EntryDate.ToString("yyyy-MM-dd")">
                            <td>@entry.EntryDate.ToString("dd/MM/yyyy")</td>
                            <td><span class="finance-direction @(entry.Type == FinancialEntryType.Expense ? "expense" : "income")"><i class="fa-solid @(entry.Type == FinancialEntryType.Expense ? "fa-arrow-down" : "fa-arrow-up")"></i> @(entry.Type == FinancialEntryType.Expense ? "Χρέωση" : "Πίστωση")</span></td>
                            <td>@FinancialCategoryName(entry.Category)</td>
                            <td><strong>@FinancialDescription(entry)</strong>@if (!string.IsNullOrWhiteSpace(entry.ReferenceNumber)){<small>@entry.ReferenceNumber</small>}</td>
                            <td class="right num @(entry.Type == FinancialEntryType.Expense ? "neg" : "pos")">@(entry.Type == FinancialEntryType.Expense ? "−" : "+")@entry.Amount.ToString("N2") €</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="producer-table-empty" data-finance-empty hidden><i class="fa-solid fa-filter-circle-xmark"></i> Δεν υπάρχουν κινήσεις για τα επιλεγμένα φίλτρα.</div>
        @if (visibleFinancialEntries.Count == 0)
        {
            <div class="portal-empty compact"><i class="fa-solid fa-receipt"></i><span>Δεν υπάρχουν κινήσεις λογαριασμού.</span></div>
        }
        <div class="delivery-pagination"><button type="button" data-finance-prev aria-label="Προηγούμενη σελίδα"><i class="fa-solid fa-chevron-left"></i></button><span data-finance-page>Σελίδα 1 από 1</span><button type="button" data-finance-next aria-label="Επόμενη σελίδα"><i class="fa-solid fa-chevron-right"></i></button></div>
        <footer class="finance-privacy-note"><i class="fa-solid fa-lock"></i> Η καρτέλα εμφανίζει μόνο τις αξίες, τις πληρωμές και τις νόμιμες χρεώσεις που αφορούν τον δικό σας λογαριασμό.</footer>
    </section>
}

@* PRODUCTION — 3 KPIs + declarations + deliveries + form *@
@if (page == "production")
{
    <div class="kpi-pro-grid" style="grid-template-columns:repeat(3,1fr)">
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-wheat-awn"></i></span><span>Δηλωμένη παραγωγή</span></div>
            <div class="kpi-pro-value">@f.DeclaredProduction.ToString("N0") <span class="unit">kg</span></div>
            <div class="kpi-pro-sub"><strong>@Model.Declarations.Count</strong> δηλώσεις</div>
        </article>
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-truck-ramp-box"></i></span><span>Παραδοτέο</span></div>
            <div class="kpi-pro-value">@f.DeliveredProduction.ToString("N0") <span class="unit">kg</span></div>
            <div class="kpi-pro-progress"><i style="width:@deliveryPct%"></i></div>
        </article>
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-euro-sign"></i></span><span>Μέση τιμή</span></div>
            <div class="kpi-pro-value">@f.AverageDeliveryPrice.ToString("N3") <span class="unit">€/kg</span></div>
        </article>
    </div>

    <div class="section-title">
        <h2>Δηλώσεις παραγωγής</h2>
        <div class="rule"></div>
        <a class="more" href="#new-declaration"><i class="fa-solid fa-plus"></i> Νέα δήλωση</a>
    </div>
    <div class="table-wrap">
        <table class="data-table pro">
            <thead><tr><th>Προϊόν</th><th class="right">Ποσότητα</th><th>Ποιότητα</th><th>Διαθεσιμότητα</th><th>Κατάσταση</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in Model.Declarations)
                {
                    <tr>
                        <td><strong>@d.Product</strong></td>
                        <td class="right num">@d.Quantity.ToString("N0") @d.Unit</td>
                        <td>@d.QualityGrade</td>
                        <td>@d.AvailableFrom.ToString("dd/MM")–@d.AvailableTo.ToString("dd/MM")</td>
                        <td><span class="status-pill @d.Status.ToString().ToLowerInvariant()">@ProductionStatusName(d.Status)</span></td>
                        <td>@if (d.Status == ProductionStatus.Available){<form asp-action="DeleteProduction" asp-route-id="@d.Id" method="post" style="margin:0"><button class="icon-delete" data-confirm="Να διαγραφεί;"><i class="fa-solid fa-trash"></i></button></form>}</td>
                    </tr>
                }
                @if (Model.Declarations.Count == 0)
                {
                    <tr><td colspan="6"><div class="portal-empty compact"><i class="fa-solid fa-wheat-awn"></i><span>Καμία δήλωση.</span></div></td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="section-title">
        <h2>Παραδόσεις προς AGRO UNION</h2>
        <div class="rule"></div>
    </div>
    <div class="table-wrap">
        <table class="data-table pro">
            <thead><tr><th>Ημερομηνία</th><th>Προϊόν</th><th class="right">Ποσότητα</th><th class="right">Τιμή</th><th>Κατάσταση</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in Model.Deals)
                {
                    <tr>
                        <td>@d.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td><strong>@d.Product</strong></td>
                        <td class="right num">@d.Quantity.ToString("N0") kg</td>
                        <td class="right num sensitive">@d.BuyPricePerUnit.ToString("N3") €</td>
                        <td><span class="status-pill @(d.Status == DealStatus.Proposed ? "proposed" : d.Status.ToString().ToLowerInvariant())">@DealStatusName(d.Status)</span></td>
                        <td>@if (d.Status == DealStatus.Proposed || d.Status == DealStatus.SellSideConfirmed){<form asp-action="ConfirmBuy" asp-route-id="@d.Id" method="post" style="margin:0"><button class="btn btn-sm"><i class="fa-solid fa-check"></i> Επιβεβαίωση</button></form>}</td>
                    </tr>
                }
                @if (Model.Deals.Count == 0)
                {
                    <tr><td colspan="6"><div class="portal-empty compact"><i class="fa-solid fa-truck-ramp-box"></i><span>Καμία παράδοση.</span></div></td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="privacy-note" style="margin-top:20px">
        <i class="fa-solid fa-lock"></i>
        <span><strong>Εμπορική ιδιωτικότητα.</strong> Εμφανίζεται μόνο η δική σας τιμή. Η μεταπώληση δεν είναι ορατή.</span>
    </div>

    <details class="producer-add-form" id="new-declaration" style="margin-top:24px">
        <summary><i class="fa-solid fa-circle-plus"></i> Νέα δήλωση παραγωγής</summary>
        <form class="workspace-form" asp-action="SaveProduction" method="post">
            <div class="field"><label>Προϊόν</label><select name="Product"><option>Ελαιόλαδο</option><option>Επιτραπέζια ελιά</option><option>Εσπεριδοειδή</option><option>Πορτοκάλια</option><option>Μανταρίνια</option><option>Λεμόνια</option><option>Ακτινίδια</option><option>Σταφύλια</option><option>Κηπευτικά</option><option>Άλλος καρπός</option></select></div>
            <div class="field"><label>Ποσότητα</label><input name="Quantity" type="number" min=".001" step=".001" /></div>
            <div class="field"><label>Μονάδα</label><input name="Unit" value="kg" /></div>
            <div class="field"><label>Ποιότητα</label><input name="QualityGrade" /></div>
            <div class="field"><label>Περιοχή</label><input name="Region" value="@p.Region" /></div>
            <div class="field"><label>Από</label><input name="AvailableFrom" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
            <div class="field"><label>Έως</label><input name="AvailableTo" type="date" value="@DateTime.Today.AddMonths(3).ToString("yyyy-MM-dd")" /></div>
            <button class="workspace-save"><i class="fa-solid fa-floppy-disk"></i> Αποθήκευση</button>
        </form>
    </details>
}

@* LOGISTICS — 4 KPIs + delivery cards *@
@if (page == "logistics")
{
    <div class="kpi-pro-grid">
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-route"></i></span><span>Δρομολόγια</span></div>
            <div class="kpi-pro-value">@logistics.TotalRoutes</div>
            <div class="kpi-pro-sub"><strong>@logistics.CompletedRoutes</strong> ολοκληρωμένα</div>
        </article>
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-weight-scale"></i></span><span>Αποδεκτό βάρος</span></div>
            <div class="kpi-pro-value">@logistics.AcceptedWeight.ToString("N0") <span class="unit">kg</span></div>
            @if (logistics.RejectedWeight > 0)
            {
                <div class="kpi-pro-sub" style="color:var(--warning)">Απορρίψεις <strong>@logistics.RejectedWeight.ToString("N0") kg</strong></div>
            }
        </article>
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-coins"></i></span><span>Καθαρό πληρωτέο</span></div>
            <div class="kpi-pro-value">@logistics.NetPayable.ToString("N0") <span class="unit">€</span></div>
        </article>
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-wallet"></i></span><span>Ανοιχτό υπόλοιπο</span></div>
            <div class="kpi-pro-value" style="color:@(logistics.Outstanding > 0 ? "var(--warning)" : "var(--ink-900)")">@logistics.Outstanding.ToString("N0") <span class="unit">€</span></div>
            <div class="kpi-pro-progress @(logistics.Outstanding > 0 ? "brass" : "")"><i style="width:@paidPct%"></i></div>
        </article>
    </div>

    <div class="section-title">
        <h2>Αναλυτικό ιστορικό φορτίων</h2>
        <div class="rule"></div>
    </div>
    <div class="producer-delivery-records">
        @if (Model.DeliveryRecords.Count == 0)
        {
            <div class="portal-empty"><i class="fa-solid fa-truck-ramp-box"></i><strong>Δεν έχουν καταχωριστεί ακόμη παραλαβές</strong><span>Μόλις η διαχείριση προγραμματίσει ένα δρομολόγιο, θα εμφανιστεί εδώ.</span></div>
        }
        @foreach (var item in Model.DeliveryRecords.OrderByDescending(x => x.ScheduledPickupAt))
        {
            <article class="producer-delivery-card status-@item.Status.ToString().ToLowerInvariant()">
                <header>
                    <span class="delivery-truck-icon"><i class="fa-solid fa-truck-fast"></i></span>
                    <div>
                        <div class="delivery-card-labels">
                            <span>@LogisticsStatusName(item.Status)</span>
                            <span class="payment-@item.PaymentStatus.ToString().ToLowerInvariant()"><i class="fa-solid fa-wallet"></i> @PaymentStatusName(item.PaymentStatus)</span>
                        </div>
                        <h3>@item.RouteNumber · @item.Product</h3>
                    </div>
                    <div class="delivery-card-date">
                        <small>Παραλαβή</small>
                        <strong>@item.ScheduledPickupAt.ToString("dd/MM/yyyy")</strong>
                    </div>
                </header>
                <div class="route-journey">
                    <div><span><i class="fa-solid fa-location-dot"></i></span><small>Φόρτωση</small><strong>@item.OriginAddress</strong></div>
                    <div class="route-line"><i class="fa-solid fa-truck"></i></div>
                    <div><span><i class="fa-solid fa-warehouse"></i></span><small>Παράδοση · @item.FactoryName</small><strong>@item.DestinationAddress</strong></div>
                </div>
                <div class="delivery-payment-result">
                    <div><small>Φορτώθηκε / έγινε αποδεκτό</small><strong>@item.NetWeight.ToString("N0") / @item.AcceptedWeight.ToString("N0") @item.WeightUnit</strong></div>
                    <div><small>Τιμή παραγωγού</small><strong>@item.UnitPrice.ToString("N4") €/@item.WeightUnit</strong></div>
                    <div><small>Καθαρό πληρωτέο</small><strong>@item.NetPayableAmount.ToString("N2") €</strong></div>
                    <div class="@(item.OutstandingAmount > 0 ? "outstanding" : "paid")"><small>Υπόλοιπο</small><strong>@item.OutstandingAmount.ToString("N2") €</strong></div>
                </div>
            </article>
        }
    </div>
}

@* INVOICES — 3 KPIs + list *@
@if (page == "invoices")
{
    var invSum = Model.Invoices.Sum(x => x.TotalAmount);
    var invPaid = Model.Invoices.Sum(x => x.PaidAmount);
    var invOpen = Model.Invoices.Sum(x => x.OutstandingAmount);

    <div class="kpi-pro-grid" style="grid-template-columns:repeat(3,1fr)">
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-file-invoice-dollar"></i></span><span>Συνολική αξία</span></div>
            <div class="kpi-pro-value">@invSum.ToString("N0") <span class="unit">€</span></div>
            <div class="kpi-pro-sub"><strong>@Model.Invoices.Count</strong> παραστατικά</div>
        </article>
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-check"></i></span><span>Εξοφλημένα</span></div>
            <div class="kpi-pro-value" style="color:var(--success)">@invPaid.ToString("N0") <span class="unit">€</span></div>
            @if (invSum > 0)
            {
                <div class="kpi-pro-progress"><i style="width:@((int)(invPaid / invSum * 100))%"></i></div>
            }
        </article>
        <article class="kpi-pro">
            <div class="kpi-pro-label"><span class="lb-ic"><i class="fa-solid fa-hourglass"></i></span><span>Ανοιχτό υπόλοιπο</span></div>
            <div class="kpi-pro-value @(invOpen > 0 ? "negative" : "")">@invOpen.ToString("N0") <span class="unit">€</span></div>
        </article>
    </div>

    <div class="section-title">
        <h2>Παραστατικά</h2>
        <div class="rule"></div>
    </div>
    <div class="invoice-list">
        @if (Model.Invoices.Count == 0)
        {
            <div class="portal-empty"><i class="fa-regular fa-file-lines"></i><strong>Δεν υπάρχουν τιμολόγια</strong><span>Θα εμφανιστούν μόλις καταχωριστούν.</span></div>
        }
        @foreach (var invoice in Model.Invoices.OrderByDescending(x => x.IssueDate))
        {
            <article class="invoice-row">
                <span class="invoice-direction @(invoice.Direction == PartnerInvoiceDirection.FromProducer ? "outgoing" : "incoming")"><i class="fa-solid @(invoice.Direction == PartnerInvoiceDirection.FromProducer ? "fa-arrow-up" : "fa-arrow-down")"></i></span>
                <div><small>@(invoice.Direction == PartnerInvoiceDirection.FromProducer ? "Εσείς → AGRO UNION" : "AGRO UNION → Εσείς")</small><strong>@invoice.InvoiceNumber</strong><span>@invoice.Description</span></div>
                <div><small>Έκδοση</small><strong>@invoice.IssueDate.ToString("dd/MM/yyyy")</strong></div>
                <div><small>Σύνολο</small><strong>@invoice.TotalAmount.ToString("N2") €</strong></div>
                <div><small>Υπόλοιπο</small><strong>@invoice.OutstandingAmount.ToString("N2") €</strong><span class="invoice-status status-@invoice.Status.ToString().ToLowerInvariant()">@InvoiceStatusName(invoice.Status)</span></div>
                @if (!string.IsNullOrWhiteSpace(invoice.FileUrl))
                {
                    <a class="document-link" href="@invoice.FileUrl" target="_blank" rel="noopener" title="Άνοιγμα"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>
                }
            </article>
        }
    </div>
}

@* DOCUMENTS — contract + documents grid *@
@if (page == "documents")
{
    <div class="pill-row">
        <span class="pill-metric"><i class="fa-solid fa-file-signature"></i> <strong>@Model.Contracts.Count</strong> συμβάσεις</span>
        <span class="pill-metric info"><i class="fa-solid fa-folder"></i> <strong>@Model.Documents.Count</strong> έγγραφα</span>
        @if (expiringDocs > 0)
        {
            <span class="pill-metric warning"><i class="fa-solid fa-clock"></i> <strong>@expiringDocs</strong> λήγουν σύντομα</span>
        }
    </div>
    <div class="document-grid">
        @foreach (var contract in Model.Contracts)
        {
            <article class="document-tile contract-tile">
                <span><i class="fa-solid fa-file-signature"></i></span>
                <div>
                    <small>Σύμβαση · @ContractStatusName(contract.Status)</small>
                    <h3>@contract.ContractNumber</h3>
                    <p>@contract.PricingTerms</p>
                    <footer><span><i class="fa-solid fa-calendar"></i> @contract.StartDate.ToString("dd/MM/yyyy")</span></footer>
                </div>
            </article>
        }
        @foreach (var document in Model.Documents)
        {
            <article class="document-tile">
                <span><i class="fa-solid fa-file-shield"></i></span>
                <div>
                    <small>@DocumentTypeName(document.Type)</small>
                    <h3>@document.Title</h3>
                    <p>@document.Notes</p>
                    <footer>
                        <span><i class="fa-solid fa-calendar"></i> @document.IssueDate.ToString("dd/MM/yyyy")</span>
                        @if (document.ExpiryDate is { } expiry){<span>Λήξη @expiry.ToString("dd/MM/yyyy")</span>}
                        @if (!string.IsNullOrWhiteSpace(document.FileUrl)){<a href="@document.FileUrl" target="_blank" rel="noopener"><i class="fa-solid fa-download"></i> Άνοιγμα</a>}
                    </footer>
                </div>
            </article>
        }
        @if (Model.Contracts.Count == 0 && Model.Documents.Count == 0)
        {
            <div class="portal-empty" style="grid-column:1/-1"><i class="fa-regular fa-folder-open"></i><strong>Κανένα έγγραφο</strong><span>Θα εμφανιστούν εδώ.</span></div>
        }
    </div>
}

@* OFFERS — offers grid + supply orders *@
@if (page == "offers")
{
    <div class="pill-row">
        <span class="pill-metric"><i class="fa-solid fa-tag"></i> <strong>@Model.Offers.Count</strong> ενεργές προσφορές</span>
        <span class="pill-metric info"><i class="fa-solid fa-boxes-stacked"></i> <strong>@Model.SupplyOrders.Count(x => x.Status == SupplyOrderStatus.Open)</strong> ανοιχτές συλλογικές</span>
    </div>

    <div class="section-title">
        <h2>Προσφορές αγοράς προς εσάς</h2>
        <div class="rule"></div>
    </div>
    <div class="offer-grid">
        @foreach (var o in Model.Offers)
        {
            <article>
                <span><i class="fa-solid fa-basket-shopping"></i></span>
                <div>
                    <small>@o.Region · έως @o.ValidUntil.ToString("dd/MM/yyyy")</small>
                    <h3>@o.Product</h3>
                    <p>Στόχος @o.TargetQuantity.ToString("N0") kg</p>
                </div>
                <strong>@o.BuyPricePerUnit.ToString("N3") €<small>/ kg</small></strong>
            </article>
        }
        @if (Model.Offers.Count == 0)
        {
            <div class="portal-empty" style="grid-column:1/-1"><i class="fa-solid fa-handshake-slash"></i><strong>Δεν υπάρχουν ενεργές προσφορές</strong><span>Θα ειδοποιηθείτε όταν δημοσιευτεί νέα.</span></div>
        }
    </div>

    @if (Model.SupplyOrders.Any())
    {
        <div class="section-title">
            <h2>Συλλογικές προμήθειες εφοδίων</h2>
            <div class="rule"></div>
        </div>
        <div class="table-wrap">
            <table class="data-table pro">
                <thead><tr><th>Παραγγελία</th><th>Προθεσμία</th><th class="right">Ποσότητα</th><th>Ενέργεια</th></tr></thead>
                <tbody>
                    @foreach (var s in Model.SupplyOrders)
                    {
                        <tr>
                            <td><strong>@s.Title</strong><br /><small style="color:var(--ink-500)">@s.Description</small></td>
                            <td>@s.Deadline.ToString("dd/MM/yyyy")</td>
                            <td class="right num">@s.TotalQuantity.ToString("N0") kg</td>
                            <td>
                                @if (s.Status == SupplyOrderStatus.Open)
                                {
                                    <form class="mini-form" asp-action="JoinSupply" method="post" style="margin:0">
                                        <input type="hidden" name="OrderId" value="@s.Id" />
                                        <input name="Quantity" type="number" step=".001" value="@s.MyQuantity" placeholder="kg" />
                                        <button class="btn btn-sm"><i class="fa-solid fa-check"></i> Συμμετοχή</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="status-pill closed">Κλειστή</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
