@model AgroUnion.Web.Services.MaintenanceViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content="120" />
    <title>@Model.Title · AGRO UNION</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" referrerpolicy="no-referrer" />
    <style>
        *,*::before,*::after{box-sizing:border-box}
        html,body{margin:0;padding:0;height:100%}
        body{
            font-family:"IBM Plex Sans","Segoe UI",Arial,sans-serif;
            color:#FBF9F3;background:#0F2417;
            display:flex;align-items:center;justify-content:center;
            padding:32px;overflow-x:hidden;
            -webkit-font-smoothing:antialiased;
        }
        .bg{
            position:fixed;inset:0;z-index:0;
            background:radial-gradient(circle at 20% 30%,rgba(46,107,72,.35),transparent 60%),
                       radial-gradient(circle at 80% 70%,rgba(198,164,91,.20),transparent 55%),
                       linear-gradient(135deg,#0F2417 0%,#14311F 100%);
        }
        .bg::after{
            content:"";position:absolute;inset:0;
            background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);
            background-size:60px 60px;
            mask-image:radial-gradient(ellipse at center,#000 40%,transparent 80%);
        }
        .card{
            position:relative;z-index:1;
            width:min(680px,100%);
            background:rgba(255,255,255,.04);
            border:1px solid rgba(255,255,255,.10);
            border-radius:24px;
            padding:56px clamp(28px,5vw,64px);
            backdrop-filter:blur(20px);
            -webkit-backdrop-filter:blur(20px);
            box-shadow:0 40px 100px rgba(0,0,0,.4);
            text-align:center;
        }
        .brand{display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:32px}
        .brand-mark{
            width:64px;height:64px;
            background:#fff;border-radius:16px;
            display:grid;place-items:center;
            box-shadow:0 12px 30px rgba(0,0,0,.3);
        }
        .brand-mark img{width:52px;height:52px;object-fit:contain;mix-blend-mode:multiply}
        .brand-text{text-align:left;line-height:1.1}
        .brand-text strong{display:block;font-size:22px;font-weight:700;letter-spacing:-.01em}
        .brand-text small{display:block;font-size:11px;letter-spacing:.18em;color:#C6A45B;text-transform:uppercase;margin-top:6px;font-weight:600}
        .icon-badge{
            width:80px;height:80px;margin:0 auto 24px;
            background:rgba(198,164,91,.15);
            border:2px solid rgba(198,164,91,.5);
            border-radius:20px;
            display:grid;place-items:center;
            color:#C6A45B;font-size:32px;
            animation:pulse 2.4s ease-in-out infinite;
        }
        @@keyframes pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.05);opacity:.85}}
        .kicker{
            display:inline-flex;align-items:center;gap:10px;
            padding:8px 16px;border-radius:999px;
            background:rgba(198,164,91,.15);color:#C6A45B;
            font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
            margin-bottom:20px;
        }
        .kicker i{font-size:8px;color:#C6A45B;animation:blink 1.4s ease-in-out infinite}
        @@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
        h1{
            font-size:clamp(30px,4.4vw,44px);font-weight:700;letter-spacing:-.02em;
            line-height:1.15;margin:0 0 20px;color:#fff;
        }
        p.msg{
            font-size:clamp(15px,1.6vw,17px);line-height:1.7;color:rgba(251,249,243,.78);
            margin:0 0 36px;max-width:520px;margin-left:auto;margin-right:auto;
        }
        .info-grid{
            display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
            gap:16px;margin-bottom:36px;
        }
        .info-tile{
            padding:20px 18px;border-radius:14px;
            background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);
            text-align:left;
        }
        .info-tile i{font-size:18px;color:#C6A45B;margin-bottom:10px;display:block}
        .info-tile strong{display:block;font-size:13px;color:#fff;font-weight:650;margin-bottom:4px}
        .info-tile small{font-size:12px;color:rgba(251,249,243,.65);line-height:1.5}
        .actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
        .btn{
            display:inline-flex;align-items:center;gap:10px;
            padding:14px 24px;border-radius:10px;
            font-size:14px;font-weight:650;text-decoration:none;
            transition:transform .15s ease,background .15s ease;
            border:1px solid transparent;
        }
        .btn-primary{background:#C6A45B;color:#0F2417}
        .btn-primary:hover{background:#D9BC77;transform:translateY(-1px)}
        .btn-ghost{background:transparent;color:#fff;border-color:rgba(255,255,255,.25)}
        .btn-ghost:hover{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.5)}
        .foot{
            margin-top:32px;padding-top:24px;border-top:1px solid rgba(255,255,255,.08);
            font-size:12px;color:rgba(251,249,243,.5);letter-spacing:.02em;
        }
        .foot a{color:#C6A45B;text-decoration:none}
        .foot a:hover{text-decoration:underline}
        @@media (max-width:600px){
            .card{padding:40px 24px}
            .brand{flex-direction:column;text-align:center}
            .brand-text{text-align:center}
        }
    </style>
</head>
<body>
    <div class="bg" aria-hidden="true"></div>
    <main class="card" role="main">
        <div class="brand">
            <span class="brand-mark"><img src="/images/agro-union-logo.png" alt="AGRO UNION" /></span>
            <span class="brand-text"><strong>AGRO UNION</strong><small>Δίκτυο συνεργασίας</small></span>
        </div>

        <div class="icon-badge"><i class="fa-solid fa-screwdriver-wrench"></i></div>

        <div class="kicker"><i class="fa-solid fa-circle"></i> Υπό συντήρηση</div>

        <h1>@Model.Title</h1>
        <p class="msg">@Model.Message</p>

        <div class="info-grid">
            <div class="info-tile">
                <i class="fa-solid fa-clock-rotate-left"></i>
                <strong>Επιστροφή σύντομα</strong>
                <small>Η σελίδα θα ανανεωθεί αυτόματα κάθε 2 λεπτά.</small>
            </div>
            <div class="info-tile">
                <i class="fa-solid fa-envelope"></i>
                <strong>Επικοινωνία</strong>
                <small>info@agro-union.gr</small>
            </div>
            <div class="info-tile">
                <i class="fa-solid fa-phone"></i>
                <strong>Τηλέφωνο</strong>
                <small>+30 26310 28971</small>
            </div>
        </div>

        <div class="actions">
            <a class="btn btn-primary" href="mailto:info@agro-union.gr"><i class="fa-solid fa-paper-plane"></i> Στείλτε email</a>
            <a class="btn btn-ghost" href="/account/login"><i class="fa-solid fa-user-shield"></i> Portal συνεργατών</a>
        </div>

        <div class="foot">© @DateTime.Now.Year AGRO UNION · Πραγματοποιούμε προγραμματισμένη συντήρηση</div>
    </main>
</body>
</html>
