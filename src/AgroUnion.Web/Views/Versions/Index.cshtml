@model AgroUnion.Web.ViewModels.ReleaseCatalogViewModel
@{
    ViewData["Title"] = "Εκδόσεις πλατφόρμας";
    var latest = Model.Releases.FirstOrDefault(x => x.IsPublished);
}

<section class="release-hero release-hero-partners">
    <div class="container release-hero-grid">
        <div class="release-hero-copy reveal">
            <span class="eyebrow eyebrow-pill"><i class="fa-solid fa-sparkles"></i> Ενημερώσεις πλατφόρμας</span>
            <h1>Η πλατφόρμα εξελίσσεται.<br /><em>Το δίκτυο ενημερώνεται.</em></h1>
            <p>Ιδιωτικό ιστορικό των εκδόσεων, των βελτιώσεων και των νέων δυνατοτήτων που είναι διαθέσιμες στα μέλη του δικτύου συνεργατών της AGRO UNION.</p>
            <div class="release-hero-actions">
                <a class="button button-primary" href="#release-catalog"><i class="fa-solid fa-list-check"></i> Προβολή ιστορικού</a>
                @if (Model.IsAdmin)
                {
                    <a class="button button-glass" href="#release-admin"><i class="fa-solid fa-plus"></i> Νέα ενημέρωση</a>
                }
            </div>
        </div>
        <aside class="release-latest-card reveal delay-1">
            @if (latest is not null)
            {
                <span class="release-latest-label"><i class="fa-solid fa-circle-check"></i> ΤΡΕΧΟΥΣΑ ΕΚΔΟΣΗ</span>
                <strong>@latest.Version</strong>
                <h2>@latest.Title</h2>
                <p>Δημοσιεύτηκε στις @latest.PublishedAtUtc.ToLocalTime().ToString("dd MMMM yyyy")</p>
                <a href="#release-@latest.Id">Δείτε τα χαρακτηριστικά <i class="fa-solid fa-arrow-down"></i></a>
            }
            else
            {
                <span class="release-latest-label"><i class="fa-solid fa-clock"></i> ΙΣΤΟΡΙΚΟ ΠΛΑΤΦΟΡΜΑΣ</span>
                <strong>—</strong>
                <h2>Δεν έχει καταχωριστεί ακόμη έκδοση</h2>
                <p>Οι επόμενες ενημερώσεις θα εμφανίζονται αυτόματα σε αυτό το σημείο.</p>
            }
        </aside>
    </div>
</section>

<section class="release-summary-strip">
    <div class="container release-summary-grid is-partner-summary">
        <article><span><i class="fa-solid fa-layer-group"></i></span><div><strong>@Model.PublishedCount</strong><small>ΔΗΜΟΣΙΕΥΜΕΝΕΣ ΕΚΔΟΣΕΙΣ</small></div></article>
        <article><span><i class="fa-solid fa-code-branch"></i></span><div><strong>@(latest?.Version ?? "—")</strong><small>ΤΡΕΧΟΥΣΑ ΕΚΔΟΣΗ</small></div></article>
        <article><span><i class="fa-solid fa-user-group"></i></span><div><strong>Μέλη</strong><small>ΠΡΟΣΒΑΣΗ ΔΙΚΤΥΟΥ ΣΥΝΕΡΓΑΤΩΝ</small></div></article>
    </div>
</section>

@if (Model.IsAdmin)
{
    <section class="section release-admin-section" id="release-admin">
        <div class="container">
            <div class="release-admin-heading">
                <div><span class="eyebrow eyebrow-pill"><i class="fa-solid fa-user-shield"></i> Διαχείριση πλατφόρμας</span><h2>Καταχώριση νέας έκδοσης</h2><p>Καταγράψτε τον αριθμό έκδοσης και παρουσιάστε με σαφήνεια τις νέες δυνατότητες και τις βελτιώσεις προς τους συνεργάτες.</p></div>
                <span class="release-security-chip"><i class="fa-solid fa-lock"></i> Μόνο διαχειριστές</span>
            </div>
            <form class="release-upload-form release-feature-form" asp-action="Create" asp-controller="Versions" method="post">
                <div class="release-form-section">
                    <header><span>01</span><div><strong>Στοιχεία ενημέρωσης</strong><small>Η πληροφορία που θα βλέπουν τα μέλη του δικτύου</small></div></header>
                    <div class="release-form-grid">
                        <div class="field"><label for="release-version">Αριθμός έκδοσης</label><div class="input-with-icon"><i class="fa-solid fa-code-branch"></i><input id="release-version" name="Version" maxlength="40" placeholder="π.χ. v2.4.0" required /></div></div>
                        <div class="field"><label for="release-title">Τίτλος ενημέρωσης</label><div class="input-with-icon"><i class="fa-solid fa-heading"></i><input id="release-title" name="Title" maxlength="180" placeholder="π.χ. Νέα οικονομική επισκόπηση" required /></div></div>
                        <div class="field"><label for="release-date">Ημερομηνία δημοσίευσης</label><div class="input-with-icon"><i class="fa-solid fa-calendar-day"></i><input id="release-date" name="PublishedAt" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div></div>
                        <div class="field full"><label for="release-notes">Νέα χαρακτηριστικά & βελτιώσεις</label><textarea id="release-notes" name="ReleaseNotes" maxlength="5000" rows="7" placeholder="Καταγράψτε κάθε νέο χαρακτηριστικό ή βελτίωση σε ξεχωριστή γραμμή..."></textarea></div>
                        <label class="release-publish-toggle"><input name="IsPublished" type="checkbox" value="true" checked /><input name="IsPublished" type="hidden" value="false" /><span><i class="fa-solid fa-eye"></i></span><div><strong>Άμεση δημοσίευση</strong><small>Απενεργοποιήστε το για αποθήκευση ως πρόχειρο</small></div></label>
                    </div>
                </div>
                <button class="release-submit" type="submit"><span><i class="fa-solid fa-check"></i> Αποθήκευση έκδοσης</span><i class="fa-solid fa-arrow-right"></i></button>
            </form>
        </div>
    </section>
}

<section class="section release-catalog-section" id="release-catalog">
    <div class="container">
        <div class="release-catalog-heading">
            <div><span class="eyebrow eyebrow-pill"><i class="fa-solid fa-clock-rotate-left"></i> Ιστορικό εκδόσεων</span><h2>Εκδόσεις και νέες δυνατότητες</h2><p>Μία καθαρή εικόνα όσων προστίθενται, βελτιώνονται ή αλλάζουν στην πλατφόρμα συνεργατών.</p></div>
            <span class="release-count">@Model.Releases.Count @(Model.Releases.Count == 1 ? "έκδοση" : "εκδόσεις")</span>
        </div>

        @if (Model.Releases.Count == 0)
        {
            <div class="release-empty"><span><i class="fa-solid fa-code-branch"></i></span><h3>Το ιστορικό είναι έτοιμο</h3><p>Δεν υπάρχουν ακόμη καταχωρισμένες εκδόσεις. Η πρώτη ενημέρωση θα εμφανιστεί εδώ μόλις δημοσιευτεί από τη διαχείριση.</p>@if (Model.IsAdmin) { <a class="button button-primary" href="#release-admin"><i class="fa-solid fa-plus"></i> Προσθήκη πρώτης έκδοσης</a> }</div>
        }
        else
        {
            <div class="release-list">
                @for (var releaseIndex = 0; releaseIndex < Model.Releases.Count; releaseIndex++)
                {
                    var release = Model.Releases[releaseIndex];
                    <article class="release-card release-feature-card @(!release.IsPublished ? "is-draft" : "")" id="release-@release.Id">
                        <header class="release-card-header">
                            <div class="release-version-mark"><small>ΕΚΔΟΣΗ</small><strong>@release.Version</strong></div>
                            <div class="release-card-title"><div class="release-badges">@if (releaseIndex == 0 && release.IsPublished) { <span class="latest"><i class="fa-solid fa-star"></i> Τελευταία</span> }<span class="@(release.IsPublished ? "published" : "draft")"><i class="fa-solid @(release.IsPublished ? "fa-circle-check" : "fa-pen-ruler")"></i> @(release.IsPublished ? "Δημοσιευμένη" : "Πρόχειρη")</span></div><h3>@release.Title</h3><span><i class="fa-regular fa-calendar"></i> @release.PublishedAtUtc.ToLocalTime().ToString("dd MMMM yyyy")</span></div>
                            <div class="release-audience"><i class="fa-solid fa-user-group"></i><span><small>ΔΙΑΘΕΣΙΜΗ ΣΤΟ</small><strong>Δίκτυο συνεργατών</strong></span></div>
                        </header>
                        <div class="release-feature-panel">
                            <div class="release-feature-heading"><span><i class="fa-solid fa-list-check"></i></span><div><small>ΧΑΡΑΚΤΗΡΙΣΤΙΚΑ ΕΚΔΟΣΗΣ</small><strong>Τι νέο περιλαμβάνει</strong></div></div>
                            @if (!string.IsNullOrWhiteSpace(release.ReleaseNotes))
                            {
                                <p>@release.ReleaseNotes</p>
                            }
                            else
                            {
                                <p class="is-empty">Δεν έχουν καταγραφεί ακόμη αναλυτικές σημειώσεις για αυτή την έκδοση.</p>
                            }
                        </div>
                        @if (Model.IsAdmin)
                        {
                            <div class="release-admin-actions">
                                <form asp-action="ToggleVisibility" asp-route-id="@release.Id" method="post"><button type="submit"><i class="fa-solid @(release.IsPublished ? "fa-eye-slash" : "fa-eye")"></i> @(release.IsPublished ? "Μεταφορά στα πρόχειρα" : "Δημοσίευση")</button></form>
                                <form asp-action="DeleteRelease" asp-route-id="@release.Id" method="post"><button class="danger" type="submit" data-confirm="Να διαγραφεί οριστικά αυτή η έκδοση;"><i class="fa-solid fa-trash-can"></i> Διαγραφή έκδοσης</button></form>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </div>
</section>
